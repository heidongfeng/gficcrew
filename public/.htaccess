# gficcrew.cn 静态站规则（Apache / 宝塔）
# 上传到站点根目录即可生效，需要站点的 AllowOverride 开着（宝塔默认是开的）。
# Cloudflare Pages 会忽略这个文件，境外版构建不受影响。

# 管理后台就部署在本站：/admin/ 前端 + /api/ 后端，数据落在 /www/gfic-data/data.json。
# 不再依赖任何外部云服务，也不再从别的域名进后台。
# 访问控制：口令登录 + 失败锁定 + 2 小时 session，见 /api/login.php。

# Retired routes -> real 301s. RedirectMatch anchors the FULL path (^...$),
# so no leftover slash is appended to the target. Plain "Redirect 301" prefix-matches
# and appended the remainder (/join/ -> //), which produced double-slash URLs.
RedirectMatch 301 ^/guangzhou/?$ /guides/guangzhou/
RedirectMatch 301 ^/guangzhou-guide/?$ /guides/guangzhou/
RedirectMatch 301 ^/join/?$ /
RedirectMatch 301 ^/account/?$ /
RedirectMatch 301 ^/homepage/?$ /

# Return the branded 404 document (with ICP filing) instead of Apache's default page.
ErrorDocument 404 /404.html
ServerSignature Off
AddDefaultCharset UTF-8

# Apache 以 FastCGI 方式跑 PHP 时默认不把 Authorization 头交给脚本，
# 这里显式透传。不加的话后台登录后的每个 /api/ 请求都会拿到空 token，被判「未授权」。
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Defense-in-depth headers supported by Apache. GitHub Pages ignores public/_headers;
# the equivalent controls for .com require a proxy/host that can set response headers.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.html$">
    # HTML 不缓存：改完内容重新上传，访客立刻看到新版，不用强刷。
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# /_astro/ 下的资源文件名自带内容 hash，浏览器缓存坏了也不会串版本，无需特殊配置。
DirectoryIndex index.html
