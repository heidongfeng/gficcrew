---
import '../styles/global.css';
import { SITE, NAV } from '../data/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description = SITE.description,
  schema,
  canonical,
  pageClass = '',
  // Overridable per page. /404.html passes noindex: robots.txt already disallows the
  // path, but a page that says "index me" while robots says "do not fetch" is a
  // contradiction, and if the meta were ever the only signal the 404 would compete in
  // search results with the real pages it is supposed to point at.
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
  // /404.html only. One 404 document answers every unmatched path, so there is no single
  // URL it belongs to: a canonical (and the hreflang pair and og:url that mirror it) can
  // only be wrong for all but one of them. Astro reports the route as /404/, which is not
  // a file the host serves either. A noindex page is not crawled for canonical anyway, so
  // the honest markup is to declare none.
  noCanonical = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonicalUrl = noCanonical ? null : canonical || new URL(path, SITE.url).href;
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
// PNG, not the SVG. X, Facebook, LinkedIn and WeChat's link previews do not render SVG
// og:image, so the card came out blank everywhere it mattered. Width/height are declared
// so the platforms can lay out the card before fetching the bytes.
const ogImage = new URL('/og-default.png', SITE.url).href;
const ogImageAlt = `${SITE.name} (${SITE.nameZh}) — ${SITE.tagline}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={(SITE.keywords || []).join(', ')} />
    <meta name="author" content="GFIC Crew" />
    <!-- max-image-preview:large lets search engines show a full-width thumbnail.
         Per-page override: /404.html sets noindex, everything else takes the default. -->
    <meta name="robots" content={robots} />
    <!-- Fallback for hosts that ignore _headers (GitHub Pages does): the header file is
         the primary control, this meta only matters where it is dropped. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <!-- Raster icons, not SVG. The logo is raster artwork, and an SVG wrapper around a
         raster would only add a base64 blob with no crispness gain. Safari below 16.4
         ignores SVG favicons outright, so this set also covers more browsers than the
         SVG-only link it replaces: .ico for tabs and bookmarks, the 192 PNG for the
         Android home screen, apple-touch-icon for the iOS one. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <!-- Self-referencing hreflang. Both builds serve the same English site to different
         regions, so this is a region mirror rather than a language alternate; the
         cross-domain pair needs a decision and is noted in docs/seo-geo-playbook.md.
         Paired with the canonical, so /404.html declares neither. -->
    {
      canonicalUrl ? (
        <>
          <link rel="alternate" hreflang="en" href={canonicalUrl} />
          <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
        </>
      ) : null
    }
    <meta name="theme-color" content="#0c6af0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GFIC Crew" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('gfic-theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {
          /* storage blocked — stay in light mode */
        }
      })();
    </script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header nav={NAV} currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
