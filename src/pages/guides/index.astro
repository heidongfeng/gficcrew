---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.js';
import { GUIDES, guideUrl } from '../../data/guides.js';
import { CITIES } from '../../data/cities.js';
import { itemListSchema, breadcrumbSchema, webPageSchema } from '../../data/schema.js';

const url = `${SITE.url}/guides/`;
const description =
  'GFIC Crew city guides for expats in China: practical, first-hand living guides covering visas, housing, banking, healthcare, transport, food, language and the social scene — Guangzhou now, more cities added regularly.';

// JSON-LD keeps the 217-character description; the meta tag gets a 143-character one.
const metaDescription =
  'First-hand expat living guides by city from GFIC Crew: visas, housing, banking, healthcare, transport, food, language and where to meet people.';

const schema = [
  webPageSchema({ url, name: 'GFIC Crew city guides', description }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url + '/' },
    { name: 'Cities & Guides', url: `${SITE.url}/cities/` },
    { name: 'City guides', url },
  ]),
  itemListSchema({
    id: `${url}#guides`,
    name: 'GFIC Crew city guides',
    description: 'Expat living guides by city.',
    items: GUIDES.map((g) => ({
      name: g.title,
      url: new URL(guideUrl(g.slug), SITE.url).href,
      description: g.description,
    })),
  }),
];
---

<BaseLayout title="City Guides — Expat Living Guides by City | GFIC Crew" description={metaDescription} schema={schema}>
  <section class="section section--tight">
    <div class="wrap wrap--measure">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/cities/">Cities &amp; Guides</a> / Guides</p>
      <h1>Expat living guides, city by city</h1>
      <p class="lead">
        Every guide is written by the crew that lives there, and the same things we walk new members
        through in their first month: visa and residence permit, apartment and deposit, bank
        account and WeChat Pay, healthcare, transport, food, language, and where to actually meet
        people.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap wrap--measure">
      <h2>Full city guides</h2>
      <div class="guide-grid">
        {
          GUIDES.map((guide) => (
            <article class="block">
              <h3><a href={guideUrl(guide.slug)}>{guide.title}</a></h3>
              <p>{guide.description}</p>
              <p class="note">Updated {guide.updated} · {guide.sections.length} sections · {guide.faq.length} FAQs</p>
            </article>
          ))
        }
      </div>

      <h2 style="margin-top:44px">How these guides are written</h2>
      <p>
        Guides are published by GFIC Crew as an organization, based on the community organizer’s
        experience in China. We add city-specific detail only when there is enough real information
        to be useful, rather than filling every city with the same template. If you spot something
        outdated, tell us on WeChat <strong>{SITE.wechat}</strong> and we will check it.
      </p>

      <h2 style="margin-top:44px">Cities without a guide yet</h2>
      <p>
        We have not written a long-form guide for these cities yet. Expats there still join us
        through the online groups and the national WeChat group. Tell us which one you need and we
        will move it up the queue.
      </p>
      <ul>
        {
          CITIES.filter((c) => !GUIDES.some((g) => g.citySlug === c.slug)).map((c) => (
            <li><a href={`/cities/#${c.slug}`}>{c.name}</a></li>
          ))
        }
      </ul>

      <p style="margin-top:26px">
        <a class="text-link" href="/contact/">Request a city guide</a>
      </p>
    </div>
  </section>
</BaseLayout>
