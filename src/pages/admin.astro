      /**
       * SEO/GEO tools. These are views rather than collections: they hold no documents and
       * have no editor, so everything the collection machinery owns (search, "new", the save
       * bar) is switched off while one is open. See openTool().
       */
      const TOOLS = {
        monitor: { label: 'AI 回答监测', title: 'AI 回答监测' },
      };

      const state = {
        pw: sessionStorage.getItem(PW_KEY) || '',
        collection: 'site',
        // Which SEO/GEO tool is open. When set, the collection machinery is bypassed.
        tool: null,
        monitor: null,
        docs: [],
        editing: null,
        busy: false,
        counts: {},
        filter: '',
        // The 站点内容 document. Event categories (and any other shared option lists) live
        // here, so editors for other collections can offer them as one-click chips.
        siteData: null,
      };

      const $ = (id) => document.getElementById(id);
      const els = {
        gate: $('gate'), gateForm: $('gate-form'), gatePw: $('gate-pw'), gateGo: $('gate-go'), gateMsg: $('gate-msg'),
        app: $('app'), side: $('side'), sideTools: $('side-tools'), pane: $('pane'), msg: $('msg'), warn: $('origin-warn'),
        title: $('title'), search: $('search'), actionbar: $('actionbar'), saveHint: $('save-hint'),
        progress: $('progress'), modal: $('modal'), modalTitle: $('modal-title'), modalText: $('modal-text'),
        publish: $('btn-publish'), publishLog: $('pub-log'),
      };

      function show(node, text, kind) {
        if (!node) return;
        node.textContent = text || '';
        node.className = 'msg' + (kind ? ' msg--' + kind : '');
      }
      function setProgress(pct) {
        if (pct === null) { els.progress.classList.add('hidden'); return; }
        els.progress.classList.remove('hidden');
        els.progress.firstElementChild.style.width = pct + '%';
      }

      function confirmDialog(text, title) {
        return new Promise((resolve) => {
          els.modalTitle.textContent = title || '确认';
          els.modalText.textContent = text;
          els.modal.classList.add('is-open');
          const done = (v) => {
            els.modal.classList.remove('is-open');
            $('modal-ok').onclick = null;
            $('modal-cancel').onclick = null;
            resolve(v);
          };
          $('modal-ok').onclick = () => done(true);
          $('modal-cancel').onclick = () => done(false);
        });
      }

      /* ---------- one-click publish ----------
       * The admin is a static page, so the button cannot upload files itself. It triggers
       * publish.yml through the GitHub Actions API. The user supplies a fine-grained token
       * with Actions: read/write only. It is AES-GCM encrypted with the admin password and
       * kept in this browser's localStorage; only the password holder can decrypt it.
       * A plaintext token is never written to the repository or the cloud database.
       */
      let publishTokenCache = '';

      const pubEnc = new TextEncoder();
      const pubDec = new TextDecoder();
      const PUB_AAD = pubEnc.encode('gfic-publish-token-v1');

      function bytesToB64(bytes) {
        let s = '';
        for (const b of bytes) s += String.fromCharCode(b);
        return btoa(s);
      }
      function b64ToBytes(text) {
        const s = atob(text);
        return Uint8Array.from(s, (c) => c.charCodeAt(0));
      }
      async function derivePublishKey(password, salt) {
        const base = await crypto.subtle.importKey('raw', pubEnc.encode(password), 'PBKDF2', false, ['deriveKey']);
        return crypto.subtle.deriveKey(
          { name: 'PBKDF2', salt, iterations: 250000, hash: 'SHA-256' },
          base,
          { name: 'AES-GCM', length: 256 },
          false,
          ['encrypt', 'decrypt'],
        );
      }
      async function savePublishToken(token) {
        const salt = crypto.getRandomValues(new Uint8Array(16));
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const key = await derivePublishKey(state.pw, salt);
        const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv, additionalData: PUB_AAD }, key, pubEnc.encode(token));
        localStorage.setItem(PUB_TOKEN_KEY, JSON.stringify({
          v: 1, salt: bytesToB64(salt), iv: bytesToB64(iv), cipher: bytesToB64(new Uint8Array(cipher)),
        }));
        publishTokenCache = token;
      }
      async function getPublishToken() {
        if (publishTokenCache) return publishTokenCache;
        const raw = localStorage.getItem(PUB_TOKEN_KEY);
        if (!raw) return '';
        try {
          const box = JSON.parse(raw);
          const key = await derivePublishKey(state.pw, b64ToBytes(box.salt));
          const plain = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: b64ToBytes(box.iv), additionalData: PUB_AAD },
            key,
            b64ToBytes(box.cipher),
          );
          publishTokenCache = pubDec.decode(plain);
          return publishTokenCache;
        } catch {
          // Usually the admin password was rotated: the old ciphertext is no longer usable.
          localStorage.removeItem(PUB_TOKEN_KEY);
          return '';
        }
      }

      async function ghFetch(token, apiPath, options = {}) {
        const res = await fetch(GH_API + apiPath, {
          ...options,
          headers: {
            Authorization: 'Bearer ' + token,
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            ...(options.body ? { 'Content-Type': 'application/json' } : {}),
          },
        });
        if (!res.ok) {
          const text = await res.text();
          let detail = '';
          try { detail = JSON.parse(text).message || ''; } catch { detail = text.slice(0, 200); }
          if (res.status === 401) throw new Error('令牌无效，请重新生成');
          if (res.status === 403) throw new Error('令牌没有 Actions 读写权限');
          if (res.status === 404) throw new Error('令牌没有这个仓库的权限');
          if (res.status === 422) throw new Error(detail || 'GitHub 拒绝了发布参数');
          throw new Error(detail || `GitHub 返回 HTTP ${res.status}`);
        }
        return res.status === 204 ? null : res.json();
      }

      async function verifyPublishToken(token) {
        // A GET only proves Actions:read. Probe the dispatch endpoint with a branch that
        // cannot exist: GitHub answers 422 when the token may dispatch, 403 when it may
        // only read, and no workflow run is created.
        const res = await fetch(GH_API + `/repos/${GH_REPO}/actions/workflows/${GH_WORKFLOW}/dispatches`, {
          method: 'POST',
          headers: {
            Authorization: 'Bearer ' + token,
            Accept: 'application/vnd.github+json',
            'Content-Type': 'application/json',
            'X-GitHub-Api-Version': '2022-11-28',
          },
          body: JSON.stringify({ ref: '__gfic_permission_check__' }),
        });
        if (res.status === 422) return true;
        if (res.status === 401) throw new Error('令牌无效，请重新生成');
        if (res.status === 403) throw new Error('令牌只有读权限，请把 Actions 改为 Read and write');
        if (res.status === 404) throw new Error('令牌没有这个仓库的权限');
        throw new Error(`无法验证发布权限（GitHub 返回 HTTP ${res.status}）`);
      }

      function setPublishBusy(busy, label) {
        els.publish.disabled = busy;
        els.publish.textContent = busy ? (label || '发布中…') : '发布上线';
      }

      function showPublishRun(run) {
        if (!run || !run.html_url) return;
        els.publishLog.href = run.html_url;
        els.publishLog.classList.remove('hidden');
      }

      function rememberPublish(run, text) {
        try {
          localStorage.setItem(PUB_LAST_KEY, JSON.stringify({
            at: new Date().toISOString(),
            status: run && run.status,
            conclusion: run && run.conclusion,
            url: run && run.html_url,
            text,
          }));
        } catch { /* storage disabled: publishing still works */ }
      }

      async function findPublishRun(token, since) {
        const data = await ghFetch(
          token,
          `/repos/${GH_REPO}/actions/workflows/${GH_WORKFLOW}/runs?event=workflow_dispatch&branch=main&per_page=20`,
        );
        const runs = (data && data.workflow_runs) || [];
        return runs.find((r) => new Date(r.created_at).getTime() >= since - 30000) || null;
      }

      async function waitForPublish(token, since) {
        let run = null;
        for (let i = 0; i < 120; i += 1) {
          await new Promise((r) => setTimeout(r, 8000));
          run = await findPublishRun(token, since);
          if (!run) {
            show(els.msg, '发布请求已提交，等待 GitHub 接收…', '');
            continue;
          }
          showPublishRun(run);
          if (run.status === 'queued') {
            show(els.msg, '已排队，等待构建机…', '');
            setPublishBusy(true, '排队中…');
          } else if (run.status === 'in_progress') {
            show(els.msg, '正在拉取内容、构建、审计并发布…', '');
            setPublishBusy(true, '发布中…');
          } else if (run.status === 'completed') {
            if (run.conclusion === 'success') {
              show(els.msg, 'gficcrew.com 已发布。国内站会在下一次拉包任务后同步。', 'ok');
              rememberPublish(run, '已上线');
            } else {
              show(els.msg, `发布失败（${run.conclusion || '未知原因'}），站点保持上一版。请打开运行日志。`, 'err');
              rememberPublish(run, '发布失败');
            }
            return run;
          }
        }
        show(els.msg, '发布仍在进行。可打开运行日志查看，页面无需一直开着。', '');
        rememberPublish(run, '仍在进行');
        return run;
      }

      async function publishNow() {
        if (!els.actionbar.classList.contains('hidden')) {
          show(els.msg, '当前有未保存的修改。请先点“保存”，再发布。', 'err');
          return;
        }
        let token = '';
        try { token = await getPublishToken(); } catch { token = ''; }
        if (!token) {
          show(els.msg, '还没有配置发布令牌，请先完成一次“发布设置”。', 'err');
          openPublishSettings();
          return;
        }
        setPublishBusy(true, '提交中…');
        show(els.msg, '正在提交发布请求…', '');
        try {
          const since = Date.now();
          await ghFetch(token, `/repos/${GH_REPO}/actions/workflows/${GH_WORKFLOW}/dispatches`, {
            method: 'POST',
            body: JSON.stringify({ ref: 'main', inputs: { source: 'admin' } }),
          });
          show(els.msg, '发布请求已提交，等待 GitHub 接收…', '');
          await waitForPublish(token, since);
        } catch (err) {
          const message = err.message || String(err);
          show(els.msg, '发布失败：' + message, 'err');
          if (/令牌|权限/.test(message)) {
            publishTokenCache = '';
            localStorage.removeItem(PUB_TOKEN_KEY);
          }
        } finally {
          setPublishBusy(false);
        }
      }

      function openPublishSettings() {
        const modal = $('pub-modal');
        const msg = $('pub-modal-msg');
        $('pub-token').value = '';
        msg.textContent = localStorage.getItem(PUB_TOKEN_KEY)
          ? '已保存过令牌。留空可直接取消；输入新令牌会覆盖旧配置。'
          : '令牌只保存在这台浏览器，不会上传到云端。';
        msg.className = 'pub-modal-msg';
        modal.classList.add('is-open');
        setTimeout(() => $('pub-token').focus(), 50);
      }

      function closePublishSettings() {
        $('pub-modal').classList.remove('is-open');
      }

      $('btn-pub-config').addEventListener('click', openPublishSettings);
      $('pub-cancel').addEventListener('click', closePublishSettings);
      $('pub-save').addEventListener('click', async () => {
        const token = $('pub-token').value.trim();
        const msg = $('pub-modal-msg');
        if (!token) {
          if (localStorage.getItem(PUB_TOKEN_KEY)) {
            closePublishSettings();
            show(els.msg, '已保留现有发布设置。', '');
          } else {
            msg.textContent = '请先粘贴 GitHub token。';
            msg.className = 'pub-modal-msg is-err';
          }
          return;
        }
        const btn = $('pub-save');
        btn.disabled = true;
        btn.textContent = '验证中…';
        msg.textContent = '正在验证仓库和 Actions 权限…';
        msg.className = 'pub-modal-msg';
        try {
          await verifyPublishToken(token);
          await savePublishToken(token);
          closePublishSettings();
          show(els.msg, '发布令牌已验证并保存。以后保存内容后点“发布上线”即可。', 'ok');
        } catch (err) {
          msg.textContent = err.message || String(err);
          msg.className = 'pub-modal-msg is-err';
        } finally {
          btn.disabled = false;
          btn.textContent = '验证并保存';
        }
      });

      els.publish.addEventListener('click', publishNow);

      function fieldLabel(cfg, key) {
        const all = (cfg.groups || [{ fields: cfg.fields }]).flatMap((g) => g.fields);
        const f = all.find((x) => x.key === key);
        return f ? f.label : key;
      }

      function getPath(obj, path) {
        return path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);
      }
      function setPath(obj, path, value) {
        const keys = path.split('.');
        const last = keys.pop();
        let cur = obj;
        for (const k of keys) {
          if (cur[k] == null || typeof cur[k] !== 'object') cur[k] = {};
          cur = cur[k];
        }
        cur[last] = value;
      }

      async function rpc(name, args) {
        const { data, error } = await db.rpc(name, args);
        if (error) throw new Error(error.message || '请求失败');
        return data;
      }
      async function list(collection) {
        return (await rpc('cms_list', { p_password: state.pw, p_collection: collection })) || [];
      }
      async function save(collection, docId, data, sortOrder) {
        await rpc('cms_save', { p_password: state.pw, p_collection: collection, p_doc_id: docId, p_data: data, p_sort_order: sortOrder || 0 });
      }
      async function remove(collection, docId) {
        await rpc('cms_delete', { p_password: state.pw, p_collection: collection, p_doc_id: docId });
      }

      /* ---------- AI content generation (managed WorkBuddy LLM, keyless) ---------- */
      // Compliance system prompt — hard guardrails against the four illegal categories we
      // just purged from the site (visa agency / job placement for foreigners / VPN / illegal work).
      const AI_SYSTEM = `You are a content editor for GFIC Crew (GFIC歪果社) — an English-language community for expats living in China. Our brand: warm, peer-to-peer, practical and reassuring. We help foreigners actually live day-to-day in China (housing, banking, transport, healthcare, food, social life, and visa/residence-permit facts). We are a community — NOT an agency, NOT a job board, NOT a visa service.

BRAND & POSITIONING
- Write for newcomers and recent arrivals; assume capable adults who just need clear, local, first-hand guidance.
- Tone: friendly but concise; no corporate fluff, no hard selling. Say "expats in China" rather than "we" — and use the city from the working context, not a fixed default city.
- Tie content to real life in China with concrete local specifics (cities, districts, apps, banks, institutions, price ranges) when relevant.
- When a recent social trend or news item is provided, connect it to everyday expat life in a useful, non-clickbait way.

WHAT WE ACTUALLY ARE — never contradict this, it is the difference between usable and unusable:
- We run in-person meetups in Guangzhou and Shenzhen ONLY. Every other city is reached through our national online WeChat group; there is nothing in person there. Never write as if we hold events, meetups, chapters or offices in any other city — not as a future plan either.
- Paid membership is not open yet and everything is free today. Write about membership as something planned, never as something a reader can buy right now.
- Never name a company, chamber, venue or organisation we have not publicly partnered with.
- Do not invent our own numbers, dates, partners or events. If a fact about GFIC itself is not in this brief or on the page being edited, do not state it.

GEO — OPTIMIZE FOR GENERATIVE ENGINE CRAWLING (domestic + foreign LLMs)
- Answer-first: open with a direct, self-contained answer to the implied question, then elaborate.
- Use explicit named entities (city, district, app, bank, policy, department); disambiguate, avoid vague pronouns.
- Structure with clear headings, short paragraphs, and "- " bullet lists so facts are extractable and quotable.
- State verifiable facts; avoid unverifiable superlatives. Keep it machine-readable.
- Neutral, standard English; minimal emoji, no clickbait, no AI clichés.

STRICT COMPLIANCE RULES — never violate:
1. Do NOT offer, imply, or advertise visa agency, visa application handling, immigration consultancy, or "we help with your visa". Explain visa/residence-permit rules factually only; never present the community as a visa service.
2. Do NOT offer job placement, job leads, internships, freelance gigs, or employment referral for foreigners. Never say the community "shares curated openings" or similar.
3. Do NOT promote, recommend, mention, or link any VPN or tool for circumventing the Great Firewall.
4. Do NOT advise working on a tourist visa, or doing remote work for a foreign employer without a proper work permit.
5. Output ONLY the requested content in the exact format requested. No preamble, no commentary.`;

      // temperature 只在「选题建议」时显式抬高：同一个 prompt 多问几次要能拿到不同方向，
      // 而不是同一句话重来。正文生成/润色不传，保持默认（要稳、要一致）。
      async function aiStream(messages, onDelta, signal, temperature) {
        const stream = await cloud.llm.chat.completions.create({
          stream: true,
          model: 'auto',
          messages,
          ...(temperature == null ? {} : { temperature }),
        });
        let buf = '';
        for await (const chunk of stream) {
          const d = chunk?.choices?.[0]?.delta?.content;
          if (d) { buf += d; onDelta(buf); }
        }
        return buf;
      }

      /*
       * 选题建议为什么要「角度 + 上下文」
       *
       * 原来那版 prompt 只写了一句「Based on the editor's recent trends/topics, propose 5 ...」，
       * 而「趋势」输入框默认是空的 —— 于是每次点下去问的都是同一句话，模型给的自然是同一批建议；
       * FAQ 页和城市指南页用的甚至是**逐字相同**的 prompt，换个城市也没有任何东西传进去。
       * 两个修法：
       *   1. aiContext() 把当前正在编辑的记录（城市 / 已写章节 / 站上已有 FAQ）真正喂进 prompt；
       *   2. IDEA_ANGLES 每点一次换一个角度，并把已经建议过的内容记下来要求不要重复。
       */

      // 一轮一个角度。六条建议必须都出自当轮角度，且彼此是同一角度下的不同子话题。
      // zh 只用于界面上告诉编辑「这批在问什么方向」，进 prompt 的是 en。
      const IDEA_ANGLES = [
        { zh: '落地第一周', en: 'first-week logistics — arrival, SIM card, bank account, deposit, what to sort out in the first 7 days' },
        { zh: '住哪、怎么租', en: 'housing — which districts, what the price tiers really feel like, what to check before signing' },
        { zh: '钱怎么转', en: 'money — banking apps, transfers, budgets, what everyday things actually cost' },
        { zh: '吃什么、怎么点', en: 'food — what to eat, when to go, how to order, dietary needs' },
        { zh: '怎么通勤', en: 'getting around — metro, ride-hailing, shared bikes, intercity trains, which apps' },
        { zh: '看病', en: 'healthcare — public hospital vs clinic, booking, insurance, pharmacies' },
        { zh: '怎么交到朋友', en: 'social life — how a newcomer actually makes friends here, and where' },
        { zh: '一年里什么时候不一样', en: 'seasonal — what changes month to month: weather, holidays, peak travel, closures' },
        { zh: '上班上学的规矩', en: 'work and study culture — office norms and language expectations (never job leads or visa advice)' },
        { zh: '带家人、长住', en: 'family and long stays — schools, pets, long-term renting, renewing documents' },
        { zh: '新手最容易搞错的事', en: 'mistakes and false expectations — what newcomers get wrong about this city' },
        { zh: '周末去哪', en: 'weekends and day trips — what is within reach and how people get there' },
      ];

      // 同一「页面 + 记录」上已经用过哪些角度、已经建议过哪些选题。
      const ideaMemo = new Map();
      function ideaState(key) {
        if (!ideaMemo.has(key)) ideaMemo.set(key, { round: 0, seen: [] });
        return ideaMemo.get(key);
      }
      function ideaKeyOf() {
        const doc = state.editing || {};
        return [state.collection || '', doc.docId || '(new)'].join('|');
      }

      // 当前记录能提供的上下文。这部分以前完全没进 prompt，是「换城市也一样」的直接原因。
      //
      // ⚠️ 必须读**表单当前值**，不能用 state.editing.data：新增时 data 是空的，
      // 用户刚在「选择城市」下拉里选了成都、还没点保存，旧数据里什么都没有 ——
      // 于是上下文为空，模型没有城市可依据（system prompt 里又拿 Guangzhou 当例子），
      // 结果成都那条也在讲白云机场和天河。这个坑实测踩到过。
      function formDataNow() {
        try {
          const form = collectFormData();
          if (form && form.data) return form.data;
        } catch {
          /* 表单还没渲染完整时，回落到原始数据 */
        }
        return (state.editing && state.editing.data) || {};
      }

      function aiContext() {
        const doc = state.editing || {};
        const data = formDataNow();
        const lines = [];

        if (state.collection === 'guides') {
          const city = String(data.city || '').trim();
          const citySlug = String(data.citySlug || '').trim();
          const title = String(data.title || '').trim();
          if (city) lines.push(`The guide being edited is for this city: ${city}${citySlug ? ' (' + citySlug + ')' : ''}. Everything must be specific to ${city}, not to China in general.`);
          if (title) lines.push(`Its current page title is: "${title}".`);
          const secs = (Array.isArray(data.sections) ? data.sections : [])
            .map((s) => (s && s.title ? String(s.title).trim() : ''))
            .filter(Boolean);
          if (secs.length) lines.push(`Sections it already has, so do NOT propose them again: ${secs.join(' | ')}.`);
          const faqN = (Array.isArray(data.faq) ? data.faq : []).filter((f) => f && f.q).length;
          if (faqN) lines.push(`It already carries ${faqN} city-specific Q&As.`);
        }

        if (state.collection === 'faq') {
          const qs = state.docs
            .filter((d) => d.docId !== doc.docId)
            .map((d) => (d.data && d.data.q ? String(d.data.q).trim() : ''))
            .filter(Boolean);
          if (qs.length) {
            lines.push(`The site already publishes ${qs.length} FAQ questions. Do NOT repeat any of these, not even rephrased — a few of them to show the level of specificity we are after:`);
            lines.push(qs.slice(0, 20).map((q) => '- ' + q).join('\n'));
          }
        }

        return lines.length ? '\n\nWORKING CONTEXT — read from the page being edited right now, use it:\n' + lines.join('\n') : '';
      }

      // Attach the "✨ AI 助手" button to the FAQ answer field and the two guide codecs.
      function maybeAddAiButton(wrap, control, field) {
        const col = state.collection;
        let mode = null;
        if (field.type === 'plaintext' && field.codec === 'faq') mode = 'faq-block';
        else if (field.type === 'plaintext' && field.codec === 'sections') mode = 'sections';
        else if (col === 'faq' && field.key === 'a') mode = 'answer';
        if (!mode) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn--ai btn--sm';
        btn.textContent = '✨ AI 助手';
        btn.addEventListener('click', () => openAiPanel(wrap, control, mode));
        wrap.appendChild(btn);
      }

      function openAiPanel(wrap, control, mode) {
        const existing = wrap.querySelector('.ai-panel');
        if (existing) { existing.remove(); return; }
        const panel = document.createElement('div');
        panel.className = 'ai-panel';

        const trends = document.createElement('textarea');
        trends.className = 'ai-trends';
        trends.rows = 2;
        trends.placeholder = '近期热点 / 社媒话题 / 新闻 / 想借势的选题（可选，生成和选题都会参考）';
        panel.appendChild(trends);

        const row = document.createElement('div');
        row.className = 'ai-row';
        const topic = document.createElement('input');
        const needTopic = (mode === 'faq-block' || mode === 'sections');
        topic.placeholder = needTopic ? '输入主题 / 章节标题（生成时用）' : '生成时将使用上方「问题」作为主题';
        topic.disabled = !needTopic;
        row.appendChild(topic);

        const gen = document.createElement('button');
        gen.type = 'button'; gen.className = 'btn btn--primary btn--sm'; gen.textContent = '生成';
        const imp = document.createElement('button');
        imp.type = 'button'; imp.className = 'btn btn--ghost btn--sm'; imp.textContent = '润色/扩写';
        const idea = document.createElement('button');
        idea.type = 'button'; idea.className = 'btn btn--ghost btn--sm'; idea.textContent = '💡 选题建议';
        const close = document.createElement('button');
        close.type = 'button'; close.className = 'btn btn--ghost btn--sm'; close.textContent = '关闭';
        row.append(gen, imp, idea, close);
        panel.appendChild(row);

        const status = document.createElement('div');
        status.className = 'ai-status';
        panel.appendChild(status);

        const out = document.createElement('div');
        out.className = 'ai-out';
        out.style.display = 'none';
        panel.appendChild(out);

        const note = document.createElement('div');
        note.className = 'ai-note';
        note.textContent =
          '选题建议会先读你正在编辑的这一条 —— 城市、已经写过的章节、站上已有的 FAQ —— 然后每点一次换一个角度，' +
          '并且不会重复前面给过的建议；上方填了热点 / 新闻也会一并参考。' +
          '生成与润色同样带着这些上下文，并受合规护栏与「广深线下、其余城市只在线上群」这两条事实约束。' +
          '结果仅为草稿，请人工审核后再保存。';
        panel.appendChild(note);

        wrap.appendChild(panel);
        close.addEventListener('click', () => panel.remove());

        let abort = null;
        // 这一面板对应的「角度轮换 + 已建议过」记录。按收藏在 Map 里，关闭面板再打开还在。
        const memo = ideaState(ideaKeyOf());
        const setBusy = (on, who) => {
          gen.disabled = on; imp.disabled = on; idea.disabled = on;
          if (who === 'gen') gen.textContent = on ? '生成中…' : '生成';
          if (who === 'imp') imp.textContent = on ? '润色中…' : '润色/扩写';
          if (who === 'idea') idea.textContent = on ? '思考中…' : memo.round > 0 ? '💡 换一批建议' : '💡 选题建议';
        };

        gen.addEventListener('click', async () => {
          const t = topic.value.trim();
          if (needTopic && !t) { status.textContent = '请先输入主题 / 章节标题。'; return; }
          if (mode === 'answer') {
            const qEl = els.pane.querySelector('[data-key="q"]');
            if (!qEl || !qEl.value.trim()) { status.textContent = '请先在上方「问题」框填写主题。'; return; }
          }
          abort = new AbortController();
          setBusy(true, 'gen'); status.textContent = '生成中…'; out.style.display = 'none';
          const append = (mode === 'faq-block' || mode === 'sections');
          const prefix = append ? (control.value.trim() ? control.value.trim() + '\n\n' : '') : '';
          try {
            const text = await aiStream(buildAiMessages(mode, 'gen', t, control.value, trends.value.trim()), (buf) => {
              control.value = prefix + buf;
            }, abort.signal);
            control.value = (append ? prefix : '') + text.trim();
            status.textContent = '已生成（草稿，请检查后保存）。';
          } catch (e) {
            status.textContent = '生成失败：' + (e?.message || e);
          } finally { setBusy(false, 'gen'); }
        });

        imp.addEventListener('click', async () => {
          const cur = control.value.trim();
          if (!cur) { status.textContent = '文本框是空的，没有可润色的内容。'; return; }
          abort = new AbortController();
          setBusy(true, 'imp'); status.textContent = '润色中…'; out.style.display = 'none';
          try {
            const text = await aiStream(buildAiMessages(mode, 'imp', topic.value.trim(), cur, trends.value.trim()), (buf) => {
              control.value = buf;
            }, abort.signal);
            control.value = text.trim();
            status.textContent = '已润色（草稿，请检查后保存）。';
          } catch (e) {
            status.textContent = '润色失败：' + (e?.message || e);
          } finally { setBusy(false, 'imp'); }
        });

        idea.addEventListener('click', async () => {
          // 每次点击前进一格角度：连点两次拿到的是两个不同方向，不是同一句话重来。
          const angle = IDEA_ANGLES[memo.round % IDEA_ANGLES.length];
          const angleName = angle.zh;
          memo.round += 1;
          abort = new AbortController();
          setBusy(true, 'idea');
          status.textContent = `第 ${memo.round} 批 · 本轮角度：${angleName}`;
          out.style.display = 'block'; out.textContent = '';
          try {
            const text = await aiStream(
              buildAiMessages(mode, 'topic', topic.value.trim(), control.value, trends.value.trim(), {
                angle,
                seen: memo.seen,
              }),
              (buf) => { out.textContent = buf; },
              abort.signal,
              1.0,
            );
            out.textContent = text.trim();
            // 记下这一批，下一批会明确要求「不要与这些重复」。
            text
              .split('\n')
              .map((s) => s.replace(/^\s*\d+\s*[.、)]\s*/, '').trim())
              .filter(Boolean)
              .forEach((s) => memo.seen.push(s));
            if (memo.seen.length > 60) memo.seen.splice(0, memo.seen.length - 60);
            status.textContent = `第 ${memo.round} 批已生成（角度：${angleName}）。挑一个填到「主题」再点「生成」；再点一次会换角度。`;
          } catch (e) {
            memo.round -= 1;
            status.textContent = '选题失败：' + (e?.message || e);
          } finally { setBusy(false, 'idea'); }
        });
      }

      function buildAiMessages(mode, action, topic, current, trends, idea) {
        const ctx = aiContext();
        // 选题建议：每轮换一个角度，并把已经建议过的明确列出来，避免「换个说法再来一遍」。
        const ideaPrompt = (what) => {
          const angle = (idea && idea.angle) || IDEA_ANGLES[0];
          const avoid = idea && idea.seen && idea.seen.length
            ? `\n\nALREADY SUGGESTED ON THIS PAGE — do NOT repeat or rephrase any of these:\n${idea.seen.slice(-24).map((s) => '- ' + s).join('\n')}`
            : '';
          const aim = what === 'sections' ? 'guide section topics, each with a one-line angle' : 'FAQ questions';
          return `Propose 6 ${aim} for GFIC Crew that a foreigner actually living in China would search for.

THIS ROUND'S ANGLE — all six must belong to this angle family, and each must be a distinct sub-topic inside it, not six rewordings of one idea:
${angle.en}${ctx}${trendCtx}${avoid}

Rules for every item:
- Be specific and local: name a city or district, an app, a document, a season or a price bracket. An item that could apply to any country is a failure.
- GEO-friendly: phrased the way someone would type it into a search box or an AI assistant.
- Compliant: no visa agency, no job placement, no VPN, no working illegally.
${what === 'sections' ? '- One line per item: the section title, then " — " and the angle it takes.\n' : ''}- Output a numbered list only. No preamble, no reasoning, no closing note.`;
        };
        const trendCtx = trends && trends.trim()
          ? `\n\nEDITOR CONTEXT — recent trends / news / social topics the editor wants this tied to (use only if genuinely relevant and keep compliant):\n${trends.trim()}`
          : '';
        let user;
        if (mode === 'faq-block') {
          if (action === 'gen') {
            user = `Write ONE FAQ entry about: "${topic}". Output exactly this format (nothing else):
Q: <a clear question an expat might ask>
A: <a concise, factual, helpful answer — lead with the direct answer, then elaborate; name concrete local specifics>
The answer must be neutral everyday-life guidance only.${trendCtx}`;
          } else if (action === 'topic') {
            user = ideaPrompt('faq');
          } else {
            user = `Improve the following FAQ entry: keep the question, rewrite the answer to be clearer, more natural, concise and answer-first. Keep the "Q: ... / A: ..." format.
${current}${ctx}${trendCtx}`;
          }
        } else if (mode === 'sections') {
          if (action === 'gen') {
            user = `Write ONE guide section titled "${topic}". Output exactly this format (nothing else):
## ${topic}
<paragraph 1 — lead with the direct point>

<paragraph 2, if useful>
- <bullet point if useful>
Use plain paragraphs separated by blank lines; "- " for bullet lists. Neutral, factual expat-life content. Name concrete local specifics — districts, apps, documents, institutions — and stay inside the city named in the working context below.${ctx}${trendCtx}`;
          } else if (action === 'topic') {
            user = ideaPrompt('sections');
          } else {
            user = `Improve the following guide section: keep the "## Title" heading, rewrite/expand the paragraphs and bullets to be clearer, answer-first and more useful. Keep the "## Title / paragraphs / - bullets" format.
${current}${ctx}${trendCtx}`;
          }
        } else {
          const qEl = els.pane.querySelector('[data-key="q"]');
          const q = qEl ? qEl.value.trim() : '';
          if (action === 'gen') {
            user = `Write a concise, factual, helpful answer to this FAQ question: "${q || topic}". Lead with the direct answer, then elaborate; name concrete local specifics. Plain English, no preamble.${ctx}${trendCtx}`;
          } else if (action === 'topic') {
            user = ideaPrompt('faq');
          } else {
            user = `Rewrite the following answer to be clearer, more natural, concise and answer-first. Keep it factual and neutral. Question: "${q}". Current answer:
${current}${ctx}${trendCtx}`;
          }
        }
        return [{ role: 'system', content: AI_SYSTEM }, { role: 'user', content: user }];
      }

      /* ---------- AI answer monitoring (GEO) ---------- */

      /**
       * Asks a model the questions real expats ask, then checks whether GFIC Crew comes up
       * on its own. The value is in the trend across runs, not in any single number.
       *
       * What this does NOT measure: ChatGPT, Perplexity, Gemini or Doubao. Each of those
       * answers from its own retrieval stack, and testing them needs accounts and API quota
       * this page does not have. This uses the managed model behind the admin, so read it as
       * an in-house baseline — "asked plainly, does a model think of us at all".
       *
       * The answer pass is never told who we are. Mention GFIC in the prompt and the result
       * means nothing, so it gets the bare question and nothing else.
       */
      const MONITOR_COLLECTION = 'monitor';
      const MONITOR_PROBES_ID = 'probes';
      const MONITOR_KEEP = 20;
      const MONITOR_ROTATION_ID = 'rotation';

      /**
       * 题库（`probe-bank.js`，随 seed 下发）与「本轮跑哪些」是两回事。
       *
       * 题库有 141 条，按 10 个分类整理，去重后剔掉了签证、职介这类我们不会去补内容的问法。
       * 但一轮不可能跑 141 条：托管模型首字延迟 40–170 秒，8 路并发实测只有 2.2 倍加速，
       * 141 条要排 18 波，远超一轮能接受的长度，浏览器还不能关。
       *
       * 更麻烦的是，题一多，那个「普通问题提及率」的百分比就失去意义 —— 它是各个分类的
       * 平均值，我们天然不强的分类会长期把它压在低位，真正有进步的分类反而看不出来。
       *
       * 所以拆成两档：
       *   core   —— 每轮必跑，固定不变。趋势线只看这一组，永远可比。
       *   rotate —— 按分类轮换抽样，覆盖长尾，单个分类六轮左右能过完一遍（配额见下面的
       *             ROUNDS_TO_COVER，改了那个常量就得同步改这句话）。
       *
       * 结果：core 11 条必跑 + rotate 按分类大小配额抽 26 条（10 类）= 一轮 37 题；
       * 报告里再按分类分别统计提及率，哪个分类是 0 一眼看得出来。
       */
      const BANK = (SEED.probeBank || []).slice();
      const CATEGORY_LABELS = new Map((SEED.probeCategories || []).map((c) => [c.id, c.label]));
      const catLabel = (id) => CATEGORY_LABELS.get(id) || id || '未分类';

      /** 把题库条目转成运行时探针对象。 */
      function bankToProbe(p) {
        return {
          id: p.id,
          kind: p.kind === 'brand' ? 'brand' : 'discovery',
          q: p.q,
          cat: p.cat || '',
          tier: p.tier === 'core' ? 'core' : 'rotate',
        };
      }

      const DEFAULT_PROBES = BANK.filter((p) => p.tier === 'core').map(bankToProbe);
      const ROTATE_POOL = BANK.filter((p) => p.tier === 'rotate');

      /**
       * 从每个分类里抽若干条 rotate 题。
       *
       * 分类大小差很多（小的 4 条、大的 26 条），固定"每分类抽 1 条"会让大分类要 26 轮
       * 才过完一遍。所以按大小配额：小分类 1 条，大分类多抽。
       * 配额 = ceil(该分类题数 / ROUNDS_TO_COVER)，即"希望在这么多轮内过完这一分类"。
       *
       * 抽样仍用「分类内序号 + 轮次」取模，保证轮轮不重样、且不需要额外存游标。
       */
      const ROUNDS_TO_COVER = 6;

      function rotationQuota(size) {
        return Math.max(1, Math.ceil(size / ROUNDS_TO_COVER));
      }

      function pickRotation(round, perCat) {
        const byCat = new Map();
        for (const p of ROTATE_POOL) {
          if (!byCat.has(p.cat)) byCat.set(p.cat, []);
          byCat.get(p.cat).push(p);
        }
        const picked = [];
        for (const [cat, items] of byCat) {
          const n = Math.min(perCat && perCat > 0 ? perCat : rotationQuota(items.length), items.length);
          // 步长取 n，让每轮各占一段互不重叠的区间；走完一圈再从头来。
          // 若按 +1 递增（round%len + k），相邻两轮会大面积重叠，整池要几十轮才走完。
          const base = (round * n) % items.length;
          for (let k = 0; k < n; k += 1) {
            picked.push(bankToProbe(items[(base + k) % items.length]));
          }
        }
        // 避免和 core 撞题（core 不在 rotate 池里，这里只是保险）。
        const coreQ = new Set(DEFAULT_PROBES.map((p) => p.q));
        return picked.filter((p) => !coreQ.has(p.q));
      }

      const PROBE_SYSTEM = `You are a helpful assistant. Someone has asked you the question below about living in China.
Answer the way you normally would: useful, specific and honest, in under 120 words.
Name concrete communities, organizations, apps or resources when they are genuinely relevant — real names only. Never invent a name.`;

      /**
       * Detection is deliberately deterministic — no second model call to "judge" the first.
       *
       * A judge call would cost another 1–3 minutes of first-token latency, and it would make
       * the numbers move whenever the model's mood changed. Counting fixed spellings against a
       * fixed watchlist keeps every run comparable, which is the whole point of a trend line.
       */
      const BRAND_RE = /GFIC\s*Crew|GFIC歪果社|\bGFIC\b|歪果社/i;

      const WATCHLIST = [
        { name: 'InterNations', re: /internations/i },
        { name: 'Meetup', re: /\bmeetup\b/i },
        { name: "That's Guangzhou", re: /that'?s\s*guangzhou/i },
        { name: 'GZStuff', re: /gzstuff/i },
        { name: 'expat.com', re: /expat\.com/i },
        { name: 'Couchsurfing', re: /couchsurfing/i },
        { name: 'Bumble BFF', re: /bumble\s*bff/i },
        { name: 'Facebook groups', re: /facebook/i },
        { name: 'Reddit', re: /\breddit\b|\br\/[a-z0-9_]+/i },
        { name: 'Quora', re: /\bquora\b/i },
        { name: 'Xiaohongshu / 小红书', re: /xiaohongshu|小红书|red\s?note/i },
        { name: 'Time Out', re: /time\s*out/i },
        { name: 'City Weekend', re: /city\s*weekend/i },
        { name: 'WeChat groups', re: /wechat\s*(group|community|account)|微信群|微信公众号/i },
      ];

      /**
       * Brand probes cannot use the same test as discovery probes. When the question already
       * contains "GFIC Crew", the model echoing the name back proves nothing. The first live
       * run scored a confident "GFIC = Grace Family International Church, an English-speaking
       * international church" as a hit; the second scored a hybrid of that same church plus
       * our own city, as a hit again.
       *
       * Two defects were behind both, and both are fixed here.
       *
       * 1. **Generic words were worth as much as our own facts.** `expat`, `Guangzhou`,
       *    `community` are true of a thousand organisations, so a fluent-sounding
       *    hallucination about "an expat social community in Guangzhou" banked three points
       *    for free and cleared the old `facts >= 3` bar. Scoring is now split: a fact is
       *    either **strong** (something only we publish — our Chinese name, our WeChat
       *    handle, our prices) or **generic** (true of everyone). Generic words alone can
       *    never add up to knowledge again.
       * 2. **"Answered about a different organisation" was not a category.** Guangzhou really
       *    does have a `GICF` (Guangzhou International Christian Fellowship) and a
       *    `Grace Family International Church` — one letter away from our abbreviation. That
       *    deserves its own verdict, with the mistaken organisation named in the report, so
       *    the next reader sees *who* we were confused with instead of a bare "wrong".
       */
      const CN_CITIES = [
        'Guangzhou', 'Shanghai', 'Beijing', 'Shenzhen', 'Chengdu', 'Hangzhou', 'Chongqing',
        'Suzhou', 'Qingdao', 'Xi’an', "Xi'an", 'Tianjin', 'Xiamen', 'Guilin', 'Yunnan',
        'Kunming', 'Dali', 'Lijiang', '广州', '上海', '北京', '深圳', '成都', '杭州', '重庆',
        '苏州', '青岛', '西安', '天津', '厦门', '桂林', '云南', '昆明', '大理', '丽江',
      ];
      const countCities = (t) => [...new Set(CN_CITIES.filter((c) => t.includes(c)))].length;

      // Only we publish these. One hit is real recall of our entity, not a good guess.
      const BRAND_STRONG = [
        { label: '中文名「歪果社」', test: (t) => /歪果社/.test(t) },
        { label: '微信 DN8117', test: (t) => /\bDN8117\b/i.test(t) },
        { label: '会员价格 RMB/¥288·688·2888', test: (t) => /(RMB|¥|￥)\s*(288|688|2888)\b/i.test(t) },
        { label: '终身会员 lifetime', test: (t) => /\blifetime\b/i.test(t) },
        // A hallucinated church will name Guangzhou; it will not reel off five of our cities.
        { label: '服务城市 ≥5 座', test: (t) => countCities(t) >= 5 },
      ];

      // True of hundreds of organisations. Kept as context, never as proof.
      const BRAND_GENERIC = [
        { label: 'expat', re: /\bexpat/i },
        { label: '外国人 / foreigner', re: /foreigner|外国人|老外|在华/ },
        { label: '广州 / Guangzhou', re: /广州|Guangzhou/i },
        { label: '社群 / community', re: /社群|community|social/i },
        { label: '会员 / membership', re: /会员|membership/i },
        { label: '活动 / events', re: /活动|events|meetup/i },
      ];

      // Other real organisations with a similar name. Naming the wrong one is far more
      // actionable than "答偏了" — it tells you what the model actually retrieved.
      // `named` entries are specific enough to be decisive on their own; the vocabulary entries
      // only count when the answer actually asserts religion (see below).
      const FOREIGN_ENTITY = [
        {
          name: 'Grace Family International Church',
          re: /grace\s*family/i,
          named: true,
          negRe: /(?:\bnot\b|\bisn'?t\b|\bno\b|不是)[^.!?。]{0,30}grace\s*family/i,
        },
        {
          name: 'Guangzhou International Christian Fellowship (GICF)',
          re: /\bGICF\b/i,
          named: true,
          negRe: /(?:\bnot\b|\bisn'?t\b|\bno\b|不是)[^.!?。]{0,30}\bGICF\b/i,
        },
        { name: '一个教会 / church', re: /\bchurch\b|教会|教堂/i },
        { name: '事工机构 / ministry', re: /\bministry\b|事工/i },
        { name: '礼拜 / worship', re: /\bworship\b|礼拜|敬拜|主日/i },
        { name: '圣经 / Bible study', re: /\bbible\b|查经|圣经|门徒/i },
        { name: '牧师 / pastor', re: /\bpastor\b|牧师|传道/i },
        { name: '团契 / fellowship', re: /\bfellowship\b|团契/i },
      ];

      // A correct answer may legitimately mention religion ("it is not a church, it's a social
      // community"). Counting denials instead of testing for one is deliberate: a first attempt
      // suppressed everything on the first `isn't ... church`, which let a real
      // "Grace Family International Church" slip through because one later clause happened to
      // be a caveat. An answer that names a church four times and disclaims it once is still
      // an answer about a church.
      const RELIGIOUS_WORD_RE = /\bchurch\b|\bministry\b|\bworship\b|\breligious\b|\bbible\b|\bpastor\b|\bfellowship\b|\bsermon\b|教会|教堂|宗教|传教|礼拜|敬拜|主日|查经|圣经|门徒|牧师|传道|团契/gi;
      const NOT_RELIGIOUS_RE = /(?:\bnot\b|\bisn'?t\b|\bno\b|\bnever\b)[^.!?]{0,40}?(?:church|ministry|worship|religious|bible|pastor|fellowship)|不是[^。！？]{0,12}(?:教会|教堂|宗教)|非(?:教会|宗教)/gi;

      // "通常是…" / "likely" / "almost certainly" / "based on the acronym" all mean the model
      // is inferring from the letters, not recalling a fact. That is not knowledge.
      const HEDGE_RE =
        /通常是|通常指|一般来说|应该是一个|可能是|可能是一个|大概|大致|推测|不确定|无法确认|据我所知|不是很有名|没有公开|未找到|我不确定|我的知识|not\s+sure|likely|probably|typically|generally\s+refers|almost\s+certainly|arguably|roughly|appears?\s+to\s+be|seems?\s+to\s+be|as\s+far\s+as\s+I\s+know|based\s+on\s+the\s+acronym|check\s+the\s+acronym|\bnames?\s+var|if\s+your\s+reference|I\s+do\s?n'?t\s+have|no\s+information|couldn'?t\s+find|not\s+familiar|as\s+of\s+my\s+knowledge|unclear|is\s+not\s+widely/i;

      // Deterministic check, no model involved: are the load-bearing facts machine-readable
      // in the first place? An engine cannot quote a fact that is not published in text.
      const SELF_CHECKS = [
        { label: '英文品牌名出现在全文', test: (t) => /GFIC Crew/.test(t) },
        { label: '中文品牌名出现', test: (t) => t.includes('歪果社') },
        { label: '列明服务城市', test: (t) => /Guangzhou/.test(t) && /Shanghai/.test(t) && /Shenzhen/.test(t) },
        { label: '写明会员价格', test: (t) => /RMB\s*\d/.test(t) },
        { label: '含微信联系方式', test: (t) => /\bDN8117\b/.test(t) },
        { label: '含成对的问答', test: (t) => /^Q: /m.test(t) && /^A: /m.test(t) },
        { label: '声明与镜像站的关系', test: (t) => /mirror is https:\/\//.test(t) },
      ];

      function monEl(tag, cls, text) {
        const el = document.createElement(tag);
        if (cls) el.className = cls;
        if (text !== undefined && text !== null) el.textContent = String(text);
        return el;
      }

      function monCard(title) {
        const card = monEl('div', 'card');
        const head = monEl('div', 'card-title');
        head.appendChild(monEl('span', null, title));
        card.appendChild(head);
        return card;
      }

      function statCard(big, label, sub) {
        const el = monEl('div', 'mon-stat');
        el.appendChild(monEl('b', null, big));
        el.appendChild(monEl('span', null, label));
        if (sub) el.appendChild(monEl('em', null, sub));
        return el;
      }

      async function llmOnce(messages) {
        const stream = await cloud.llm.chat.completions.create({ stream: true, model: 'auto', messages });
        let buf = '';
        for await (const chunk of stream) {
          const d = chunk?.choices?.[0]?.delta?.content;
          if (d) buf += d;
        }
        return buf;
      }

      /**
       * 腾讯云 WAF 会把「同一来源、短时间、同一接口的大量 POST」当成 CC 攻击拦掉，
       * 返回一页 403 HTML。SDK 的 `if (!response.ok)` 直接把响应体当 error.message 抛出，
       * 而它的重试白名单是 `RETRYABLE_STATUS_CODES = [520, 503]` 且 `RETRYABLE_METHODS`
       * 只收 GET/HEAD/OPTIONS —— **LLM 走的是 POST，403 又不在名单里，所以一次都不会重试**，
       * 整页 HTML 就直接糊到界面上了。
       *
       * 这里用「响应体是不是 HTML」来认它（比抠状态码稳：WAF 页、网关错误页都会被这条捞住），
       * 认出来就退避重试，而不是把 HTML 当答案或当错误抛出去。
       */
      function isWafOrHtmlError(err) {
        const s = String((err && (err.message || err)) || '');
        return /<!DOCTYPE|<html|WAF拦截|您的请求已中断|CloudStudio Gateway|Request blocked/i.test(s);
      }

      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      /** 带退避重试的单次探针调用。WAF 拦截退避后重试，其余错误原样抛。 */
      async function llmWithRetry(messages, { onRetry } = {}) {
        const MAX_TRIES = 4;
        let last = null;
        for (let attempt = 1; attempt <= MAX_TRIES; attempt += 1) {
          try {
            return await llmOnce(messages);
          } catch (err) {
            last = err;
            if (!isWafOrHtmlError(err) || attempt === MAX_TRIES) throw err;
            // 指数退避 + 抖动：2s, 5s, 12s 上下。退避是给 WAF 一个"你不是攻击者"的证据。
            const base = [2000, 5000, 12000][attempt - 1] ?? 12000;
            const wait = base + Math.floor(Math.random() * 1500);
            if (onRetry) onRetry(attempt, wait);
            await sleep(wait);
          }
        }
        throw last;
      }

      /** 把 SDK 抛出来的原始错误（可能是整页 HTML）压成一句人话。 */
      function humanError(err) {
        if (isWafOrHtmlError(err)) {
          return '请求被站点安全策略（腾讯云 WAF）拦截。通常是短时间内请求太多，把这一轮当成攻击了。建议：把并发调低、隔几分钟再跑，或分批跑。';
        }
        return String((err && (err.message || err)) || err);
      }

      function monitorProbes(raw) {
        // 排好的本轮探针（云端存过就用自己的，否则回落到 core 全量）。
        const list = Array.isArray(raw) && raw.length ? raw : DEFAULT_PROBES;
        const out = list
          .map((p, i) => ({
            id: String((p && p.id) || 'p' + (i + 1)),
            kind: p && p.kind === 'brand' ? 'brand' : 'discovery',
            q: String((p && p.q) || '').trim(),
            cat: String((p && p.cat) || ''),
            tier: p && p.tier === 'rotate' ? 'rotate' : 'core',
          }))
          .filter((p) => p.q);
        return out.length ? out : DEFAULT_PROBES.map((p) => ({ ...p }));
      }

      /** 当前轮次。首轮 0，每跑完一轮 +1，用于 rotate 抽样错开。 */
      function currentRound() {
        return Number(state.monitor && state.monitor.round) || 0;
      }

      /**
       * 本轮要跑的题 = core 全部 + rotate 按分类配额抽样。
       * perCat 传 0 表示用自动配额（分类越大抽越多，见 rotationQuota）。
       * 用户手改过的探针（编辑器里加/删/改）会被 collectProbes 收进 state，
       * 这里只在首轮载入、点「换一批轮换题」或「重置为题库首轮」时重建。
       */
      function composeRound(round, perCat) {
        return DEFAULT_PROBES.concat(pickRotation(round, perCat));
      }

      async function openMonitor() {
        els.pane.innerHTML = '';
        setProgress(null);
        show(els.msg, '载入中…', '');

        const boot = monCard('AI 回答监测');
        boot.appendChild(monEl('p', 'mon-note', '正在读取历史报告…'));
        els.pane.appendChild(boot);

        let probes = composeRound(0, 0).map((p) => ({ ...p }));
        let history = [];
        let round = 0;
        try {
          const rows = await list(MONITOR_COLLECTION);
          const probeRow = rows.find((r) => r.docId === MONITOR_PROBES_ID);
          const rotRow = rows.find((r) => r.docId === MONITOR_ROTATION_ID);
          if (rotRow && rotRow.data) round = Number(rotRow.data.round) || 0;
          // 云端存过排好的题就用它，否则按题库重新排一轮（首轮 / 首次升级时）。
          if (probeRow && probeRow.data) probes = monitorProbes(probeRow.data.list);
          else probes = composeRound(round, 0).map((p) => ({ ...p }));
          history = rows
            .filter((r) => r.docId !== MONITOR_PROBES_ID && r.docId !== MONITOR_ROTATION_ID && r.data)
            .sort((a, b) => String(a.docId).localeCompare(String(b.docId)));
        } catch (err) {
          show(els.msg, '读取历史失败：' + (err.message || err), 'err');
        }
        state.monitor = { probes, history, running: false, log: '', round };
        renderMonitor();
        show(els.msg, '', '');
      }

      function renderMonitor() {
        const m = state.monitor;
        if (!m) return;
        const pane = els.pane;
        pane.innerHTML = '';
        pane.appendChild(monitorControls(m));
        monitorReportNodes(m).forEach((n) => pane.appendChild(n));
        if (m.history.length > 1) pane.appendChild(monitorHistory(m));
        pane.appendChild(monitorSelfCheckCard());
        pane.appendChild(monitorCaveatCard());
      }

      function probeRow(p, i) {
        const row = monEl('div', 'mon-probe');
        row.dataset.id = p.id;
        row.dataset.i = String(i);
        if (p.tier !== 'rotate' && p.cat !== 'brand') row.dataset.tier = 'core';
        if (p.tier === 'rotate') row.dataset.tier = 'rotate';

        const sel = document.createElement('select');
        [['discovery', '普通问题'], ['brand', '品牌问题']].forEach(([v, label]) => {
          const o = document.createElement('option');
          o.value = v;
          o.textContent = label;
          if (p.kind === v) o.selected = true;
          sel.appendChild(o);
        });

        const inp = document.createElement('input');
        inp.type = 'text';
        inp.value = p.q;
        inp.placeholder = '例如：Where can I meet other foreigners in Guangzhou?';

        // 分类 + 档位标签：一眼看出这条是固定核心还是本轮轮换，属于哪一类。
        const tag = monEl('span', 'mon-tag', p.cat === 'brand' ? '品牌' : catLabel(p.cat));
        tag.title = p.tier === 'rotate' ? '轮换题（每轮换一批）' : '固定核心题（每轮必跑）';
        if (p.tier === 'rotate') tag.classList.add('mon-tag--rot');

        const del = monEl('button', 'btn btn--ghost btn--sm', '移除');
        del.type = 'button';
        del.addEventListener('click', () => {
          const dropped = collectProbes();
          state.monitor.probes = state.monitor.probes.filter((x) => x.id !== p.id);
          if (!state.monitor.probes.length) state.monitor.probes = DEFAULT_PROBES.map((x) => ({ ...x }));
          renderMonitor();
          if (dropped) show(els.msg, `已忽略 ${dropped} 条空问题。`, 'warn');
        });
        row.append(tag, sel, inp, del);
        return row;
      }

      /** Reads the probe editor back into state, dropping blank rows. Returns how many went. */
      function collectProbes() {
        const m = state.monitor;
        if (!m) return 0;
        const byId = new Map(m.probes.map((p) => [p.id, p]));
        els.pane.querySelectorAll('#mon-probes .mon-probe').forEach((row) => {
          const p = byId.get(row.dataset.id);
          if (!p) return;
          const sel = row.querySelector('select');
          const inp = row.querySelector('input');
          if (sel) p.kind = sel.value === 'brand' ? 'brand' : 'discovery';
          if (inp) p.q = inp.value.trim();
        });
        const before = m.probes.length;
        m.probes = m.probes.filter((p) => !!p.q);
        return before - m.probes.length;
      }

      function monitorControls(m) {
        const coreN = m.probes.filter((p) => p.tier !== 'rotate').length;
        const rotN = m.probes.length - coreN;
        const card = monCard(`本轮探针（${m.probes.length}）`);
        card.appendChild(
          monEl(
            'p',
            'mon-note',
            `题库共 ${BANK.length} 条，本轮跑 ${m.probes.length} 条：固定核心 ${coreN} 条 + 分类轮换 ${rotN} 条（分类越大抽越多）。` +
              `点「开始监测」：每个问题先让模型按平时的样子回答一遍（不告诉它我们是谁），再统一评审有没有提到 GFIC Crew。` +
              `8 路并发，等的是模型首字延迟（实测 40–170 秒），一轮约 8–12 分钟，走开就行，页面每 10 秒报一次进度。` +
              `「换一批轮换题」会跳到下一组，不动固定的核心题；约 ${ROUNDS_TO_COVER} 轮过完整个轮换池。`,
          ),
        );

        const list = monEl('div');
        list.id = 'mon-probes';
        m.probes.forEach((p, i) => list.appendChild(probeRow(p, i)));
        card.appendChild(list);

        const row = monEl('div', 'mon-actions');

        const run = monEl('button', 'btn btn--primary', '开始监测');
        run.type = 'button';
        run.id = 'mon-run';
        run.disabled = !!m.running;
        run.addEventListener('click', () => runMonitor());

        const shuffle = monEl('button', 'btn btn--ghost btn--sm', '换一批轮换题');
        shuffle.type = 'button';
        shuffle.addEventListener('click', () => {
          const dropped = collectProbes();
          const next = (currentRound() + 1) % 997;
          state.monitor.round = next;
          state.monitor.probes = composeRound(next, 0).map((p) => ({ ...p }));
          renderMonitor();
          show(els.msg, `已换一批轮换题（第 ${next + 1} 组）${dropped ? `，忽略 ${dropped} 条空问题` : ''}。`, 'warn');
        });

        const add = monEl('button', 'btn btn--ghost btn--sm', '+ 添加问题');
        add.type = 'button';
        add.addEventListener('click', () => {
          const dropped = collectProbes();
          m.probes.push({ id: 'p' + Date.now().toString(36), kind: 'discovery', q: '' });
          renderMonitor();
          const inputs = els.pane.querySelectorAll('#mon-probes input');
          if (inputs.length) inputs[inputs.length - 1].focus();
          if (dropped) show(els.msg, `已忽略 ${dropped} 条空问题。`, 'warn');
        });

        const saveSet = monEl('button', 'btn btn--ghost btn--sm', '保存问题集');
        saveSet.type = 'button';
        saveSet.addEventListener('click', async () => {
          const dropped = collectProbes();
          saveSet.disabled = true;
          saveSet.textContent = '保存中…';
          try {
            await save(MONITOR_COLLECTION, MONITOR_PROBES_ID, { list: m.probes, updated: new Date().toISOString() }, 0);
            await save(MONITOR_COLLECTION, MONITOR_ROTATION_ID, { round: currentRound(), updated: new Date().toISOString() }, 0);
            saveSet.textContent = '已保存';
            show(els.msg, `本轮题目已存到云端${dropped ? `（忽略 ${dropped} 条空问题）` : ''}。`, 'ok');
          } catch (err) {
            saveSet.textContent = '保存失败';
            show(els.msg, '问题集保存失败：' + (err.message || err), 'err');
          }
          setTimeout(() => {
            saveSet.disabled = false;
            saveSet.textContent = '保存问题集';
          }, 1800);
        });

        const reset = monEl('button', 'btn btn--ghost btn--sm', '重置为题库首轮');
        reset.type = 'button';
        reset.addEventListener('click', () => {
          m.round = 0;
          m.probes = composeRound(0, 0).map((p) => ({ ...p }));
          renderMonitor();
          show(els.msg, '已重置为题库首轮（还没保存到云端）。', 'warn');
        });

        row.append(run, shuffle, add, saveSet, reset);
        card.appendChild(row);

        const log = monEl('div', 'mon-log');
        log.id = 'mon-log';
        log.textContent = m.log || '尚未运行。';
        card.appendChild(log);
        return card;
      }

      function monitorReportNodes(m) {
        if (!m.history.length) {
          const card = monCard('最新报告');
          card.appendChild(monEl('p', 'mon-note', '还没有报告。点上面的「开始监测」跑一次，之后每次运行都会留一份在这里。'));
          return [card];
        }
        return reportNodes(m.history[m.history.length - 1].data, m.history);
      }

      function reportNodes(r, history) {
        const s = r.summary || {};
        const out = [];

        const ov = monCard('最新报告');
        const head = monEl('div', 'mon-head');
        // 大数字只报固定核心题 —— 这才是能跨轮比较的那个。全量数字放副标题里。
        const coreN = s.coreTotal ?? s.discoveryTotal ?? 0;
        head.appendChild(
          statCard(
            `${s.coreRate ?? s.discoveryRate ?? 0}%`,
            `核心题提及率 ${s.coreHit ?? s.discoveryHit ?? 0}/${coreN}`,
            `固定题，跨轮可比。本轮全部普通题（含轮换）为 ${s.discoveryHit ?? 0}/${s.discoveryTotal ?? 0}`,
          ),
        );
        head.appendChild(
          statCard(
            `${s.brandRate ?? 0}%`,
            `品牌问题「真认识」 ${s.brandHit ?? 0}/${s.brandTotal ?? 0}`,
            s.brandWrong
              ? `有 ${s.brandWrong} 题答的是同名但不同的东西 —— 这类"假命中"不能算认识`
              : '直接问「GFIC Crew 是什么」，看它真知道还是在猜',
          ),
        );
        if (history && history.length > 1) {
          const prev = ((history[history.length - 2].data || {}).summary) || {};
          const prevRate = prev.coreRate ?? prev.discoveryRate ?? 0;
          const d = (s.coreRate ?? s.discoveryRate ?? 0) - prevRate;
          head.appendChild(
            statCard(`${d > 0 ? '+' : ''}${d}`, '与上次相比（百分点）', d > 0 ? '有进步' : d < 0 ? '退步了' : '没有变化'),
          );
        }
        ov.appendChild(head);

        const meta = [];
        if (r.at) meta.push('生成时间 ' + new Date(r.at).toLocaleString('zh-CN'));
        if (r.model) meta.push('模型 ' + r.model);
        if (s.failed) meta.push(`${s.failed} 题调用失败，未计入比例`);
        const metaP = monEl('p', 'mon-note', meta.join(' · '));
        metaP.style.marginTop = '12px';
        ov.appendChild(metaP);
        out.push(ov);

        const tb = monCard(`逐题结果（${(r.rows || []).length} 题）`);
        const table = monEl('table', 'mon-table');
        const thead = monEl('thead');
        const htr = monEl('tr');
        ['问题', '我们', 'AI 更愿意点名的', '原话 / 说明'].forEach((h) => htr.appendChild(monEl('th', null, h)));
        thead.appendChild(htr);
        table.appendChild(thead);
        const tbody = monEl('tbody');
        for (const row of r.rows || []) {
          const tr = monEl('tr');
          tr.appendChild(monEl('td', 'q', (row.kind === 'brand' ? '[品牌] ' : '') + row.q));
          const cell = monEl('td');
          // Reports written by an older build have no `status` — fall back rather than throw.
          const st = row.status || { tone: row.mentioned ? 'part' : 'miss', label: row.mentioned ? '提及' : '未提及' };
          cell.appendChild(monEl('span', 'mon-tag ' + st.tone, st.label));
          tr.appendChild(cell);
          tr.appendChild(monEl('td', 'who', row.alternatives && row.alternatives.length ? row.alternatives.join('、') : '—'));
          const ev = monEl('td');
          // Why this row got its verdict. Without it a mis-judgement is invisible and you have
          // to come back and ask. Brand rows only — discovery rows have no facts to show.
          if (row.kind === 'brand') {
            const reason = row.brandEntity
              ? '被认成：' + row.brandEntity
              : row.brandFacts && row.brandFacts.length
                ? '命中我们独有的事实：' + row.brandFacts.join('、')
                : '命中我们独有的事实：无' +
                  (row.brandGeneric && row.brandGeneric.length
                    ? ` —— 只有 ${row.brandGeneric.join('、')} 这类换个机构也成立的词`
                    : '');
            const note = monEl('div', 'mon-note', reason);
            note.style.marginTop = '2px';
            ev.appendChild(note);
          }
          if (row.quote) ev.appendChild(monEl('div', null, '「' + row.quote + '」'));
          else if (row.error) ev.appendChild(monEl('div', null, row.error));
          if (row.answer) {
            const det = document.createElement('details');
            const sum = document.createElement('summary');
            sum.textContent = '看完整回答（' + row.chars + ' 字）';
            det.appendChild(sum);
            const pre = monEl('div', 'mon-answer', row.answer);
            det.appendChild(pre);
            ev.appendChild(det);
          }
          if (!ev.childNodes.length) ev.textContent = '—';
          tr.appendChild(ev);
          tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        // 手机上这表有 4 列，直接放会把整页撑出横向滚动条 —— 装进可横滑的容器里。
        const tscroll = monEl('div', 'mon-scroll mon-scroll--wide');
        tscroll.appendChild(table);
        tb.appendChild(tscroll);

        // 分类提及率：总数字是平均值，这个才是"哪个入口是 0"的答案。
        if (Array.isArray(s.byCategory) && s.byCategory.length) {
          const cb = monCard('按提问分类看提及率');
          cb.appendChild(
            monEl(
              'p',
              'mon-note',
              '每个分类只跑了少数几题，看的是「哪一类入口我们完全不存在」，不要拿单题的百分比当结论。提及率低且站内也没有对应内容的分类，就是下一批该写的东西。',
            ),
          );
          const ctable = monEl('table', 'mon-table');
          const cthead = monEl('thead');
          const chtr = monEl('tr');
          ['分类', '提及', '提及率'].forEach((h) => chtr.appendChild(monEl('th', null, h)));
          cthead.appendChild(chtr);
          ctable.appendChild(cthead);
          const ctbody = monEl('tbody');
          for (const b of s.byCategory) {
            const tr = monEl('tr');
            tr.appendChild(monEl('td', 'q', b.label));
            tr.appendChild(monEl('td', 'who', `${b.hit}/${b.total}`));
            const td = monEl('td');
            const tone = b.rate === 0 ? 'miss' : b.rate >= 50 ? 'hit' : 'part';
            td.appendChild(monEl('span', 'mon-tag ' + tone, `${b.rate}%`));
            tr.appendChild(td);
            ctbody.appendChild(tr);
          }
          ctable.appendChild(ctbody);
          const cscroll = monEl('div', 'mon-scroll');
          cscroll.appendChild(ctable);
          cb.appendChild(cscroll);
          out.push(cb);
        }

        if (Array.isArray(s.alternatives) && s.alternatives.length) {
          const lead = monEl('p', 'mon-note', 'AI 更愿意点名的替代来源（在几道题里出现过）：');
          lead.style.marginTop = '16px';
          tb.appendChild(lead);
          const chips = monEl('div', 'mon-chips');
          for (const c of s.alternatives) {
            const chip = monEl('span', 'mon-chip');
            chip.appendChild(document.createTextNode(c.name + ' '));
            chip.appendChild(monEl('b', null, String(c.count)));
            chips.appendChild(chip);
          }
          tb.appendChild(chips);
        }

        const tools = monEl('div', 'mon-actions');
        const btn = monEl('button', 'btn btn--ghost btn--sm', '导出 Markdown');
        btn.type = 'button';
        btn.addEventListener('click', () => downloadMonitorMarkdown(r));
        tools.appendChild(btn);
        tb.appendChild(tools);
        out.push(tb);

        if (Array.isArray(r.advice) && r.advice.length) {
          const adv = monCard('下一步建议');
          const ul = monEl('ul', 'mon-list');
          r.advice.forEach((a) => ul.appendChild(monEl('li', null, String(a))));
          adv.appendChild(ul);
          const prov = monEl('p', 'mon-note', r.adviceBy === 'ai' ? '由模型读完报告后写的。' : '按规则生成的（跑一轮探针就要几分钟，这一步不再额外等模型）。');
          prov.style.marginTop = '12px';
          adv.appendChild(prov);
          const acts = monEl('div', 'mon-actions');
          const ai = monEl('button', 'btn btn--ghost btn--sm', r.adviceBy === 'ai' ? '重新让 AI 写一版' : '让 AI 写一版更具体的');
          ai.type = 'button';
          ai.addEventListener('click', () => {
            ai.disabled = true;
            ai.textContent = '生成中…';
            aiAdviceFor(m.history[m.history.length - 1] && m.history[m.history.length - 1].docId);
          });
          acts.appendChild(ai);
          adv.appendChild(acts);
          out.push(adv);
        }
        return out;
      }

      function monitorHistory(m) {
        const card = monCard(`历史趋势（最近 ${m.history.length} 次）`);
        const bars = monEl('div', 'mon-hist');
        for (const row of m.history) {
          const s = (row.data || {}).summary || {};
          // 柱子一律用核心题比率。旧报告没有 coreRate，回落到全量比率，柱子仍可读。
          const pct = s.coreRate ?? s.discoveryRate ?? 0;
          const bar = monEl('div', 'mon-bar');
          const fill = monEl('i');
          fill.style.height = Math.max(2, Math.min(100, pct)) + '%';
          bar.appendChild(fill);
          bar.title = `${String(row.docId).replace(/^run-/, '').slice(0, 10)} · 核心题提及率 ${pct}%（${s.coreHit ?? s.discoveryHit ?? 0}/${s.coreTotal ?? s.discoveryTotal ?? 0}）`;
          bars.appendChild(bar);
        }
        card.appendChild(bars);
        card.appendChild(
          monEl('p', 'mon-note', '每根柱子 = 一次报告里「固定核心题被提及的比例」（跨轮可比），鼠标悬停看具体数字。一直贴底，说明内容还没进入模型答案池。'),
        );
        return card;
      }

      function monitorSelfCheckCard() {
        const card = monCard('机器可读性体检（/llms-full.txt）');
        card.appendChild(
          monEl(
            'p',
            'mon-note',
            '这一项不靠模型：直接读线上的 llms-full.txt，检查关键事实在不在里面。引擎引用我们的前提，是这些事实先能被读到。',
          ),
        );
        const box = monEl('div');
        box.textContent = '检查中…';
        card.appendChild(box);
        selfCheck().then((res) => {
          box.innerHTML = '';
          if (!res.ok) {
            box.appendChild(
              monEl('p', 'mon-note', `读不到 /llms-full.txt（${res.error}）。这个页面可能不是从已发布的站点打开的。`),
            );
            return;
          }
          res.checks.forEach((c) => {
            const line = monEl('div', 'mon-check');
            line.appendChild(monEl('i', null, c.pass ? '✓' : '✗'));
            line.appendChild(monEl('span', null, c.label));
            box.appendChild(line);
          });
          const fails = res.checks.filter((c) => !c.pass).length;
          box.appendChild(
            monEl(
              'p',
              'mon-note',
              `共 ${res.checks.length} 项，${fails ? fails + ' 项缺失' : '全部通过'}。文件 ${res.size.toLocaleString()} 字符。`,
            ),
          );
        });
        return card;
      }

      function monitorCaveatCard() {
        const card = monCard('这份报告能说明什么、不能说明什么');
        const ul = monEl('ul', 'mon-list');
        [
          '能说明：一个模型被直接提问时，会不会自己想到 GFIC Crew。这是站内基线，用来和不同时间的自己比。',
          '不能说明：ChatGPT / Perplexity / Gemini / 豆包 的真实回答。它们各有自己的检索与索引，要测需要那些服务的账号和额度。',
          '所以看趋势，不看单次数字。持续为 0 = 内容还没进入任何模型的答案池；突然跳高，先怀疑是提示词或模型换了。',
          '跨轮比较只看「固定核心题」那一组 —— 轮换题每轮不一样，总百分比会跟着题目走。分类表同理：每类只跑了少数几题，看的是哪一类是 0，不是精确比例。',
          '真正拉动这个数字的动作在站外（Reddit / Quora / 媒体报道 / 维基）。站内把内容做扎实只是必要条件，不是充分条件。',
        ].forEach((t) => ul.appendChild(monEl('li', null, t)));
        card.appendChild(ul);
        return card;
      }

      async function selfCheck() {
        try {
          const res = await fetch(new URL('/llms-full.txt', location.origin).href, { cache: 'no-store' });
          if (!res.ok) return { ok: false, error: 'HTTP ' + res.status, size: 0, checks: [] };
          const text = await res.text();
          return { ok: true, size: text.length, checks: SELF_CHECKS.map((c) => ({ label: c.label, pass: c.test(text) })) };
        } catch (err) {
          return { ok: false, error: err?.message || String(err), size: 0, checks: [] };
        }
      }

      /** The sentence around the mention — the evidence for *why* it named us. */
      function sentenceAround(text, index) {
        if (index < 0) return '';
        const marks = ['.', '\n', '。', '!', '?'];
        let before = -1;
        for (const m of marks) before = Math.max(before, text.lastIndexOf(m, index - 1));
        let after = -1;
        const tail = text.slice(index);
        for (const m of marks) {
          const at = tail.indexOf(m);
          if (at >= 0 && (after < 0 || at < after)) after = at;
        }
        const s = text.slice(before + 1, after < 0 ? text.length : index + after + 1).replace(/\s+/g, ' ').trim();
        return s.length > 240 ? s.slice(0, 240) + '…' : s;
      }

      /**
       * Deterministic scoring. Kept model-free on purpose: a second "judge" call would add
       * another 1–3 minutes of latency and would make the numbers drift whenever the model
       * felt differently. Fixed spellings against a fixed watchlist stay comparable.
       */
      function analyseAnswers(results) {
        return results.map((r) => {
          const answer = r.answer || '';
          const idx = answer ? answer.search(BRAND_RE) : -1;
          const mentioned = idx >= 0;

          // Discovery probes: the question never names us, so a hit is a real, unprompted
          // mention. Brand probes: the question names us, so a hit means nothing on its own.
          //
          // Brand verdicts, applied in order. Order matters: being answered about a different
          // organisation outranks everything — such an answer is fluent and confident, so the
          // hedge check would miss it and the fact check could be fooled by the words we share.
          let brand = null;
          let brandFacts = [];
          let brandGeneric = [];
          let brandEntity = '';
          if (!r.error && r.kind === 'brand') {
            const strongLabels = BRAND_STRONG.filter((f) => f.test(answer)).map((f) => f.label);
            const genericLabels = BRAND_GENERIC.filter((f) => f.re.test(answer)).map((f) => f.label);
            brandGeneric = genericLabels;

            // Naming a specific other organisation is decisive on its own — you do not type
            // "Grace Family International Church" by accident. The loose religious vocabulary
            // only counts when it is truly asserted: total mentions minus explicitly denied ones.
            const namedOrg = FOREIGN_ENTITY.filter(
              (f) => f.named && f.re.test(answer) && !(f.negRe && f.negRe.test(answer)),
            );
            const asserted = (answer.match(RELIGIOUS_WORD_RE) || []).length - (answer.match(NOT_RELIGIOUS_RE) || []).length > 0;
            const foreign = namedOrg.length
              ? namedOrg
              : asserted
                ? FOREIGN_ENTITY.filter((f) => !f.named && f.re.test(answer))
                : [];

            brandEntity = foreign.map((f) => f.name).join('、');

            if (foreign.length) brand = 'wrong';
            else if (strongLabels.length >= 2) brand = 'known';
            else if (HEDGE_RE.test(answer)) brand = 'guessed';
            else if (strongLabels.length >= 1 && genericLabels.length >= 2) brand = 'known';
            else brand = 'wrong';

            // Only the strong ones are listed as evidence when the verdict is "wrong": showing
            // the generic matches there would reintroduce the illusion that "expat + Guangzhou"
            // proves anything. When the verdict is "known" the generic words are real context.
            brandFacts = brand === 'known' ? strongLabels.concat(genericLabels) : strongLabels;
          }

          const status = r.error
            ? { tone: 'miss', label: '调用失败' }
            : r.kind === 'brand'
              ? brand === 'known'
                ? { tone: 'hit', label: '真认识' }
                : brand === 'guessed'
                  ? { tone: 'part', label: '在猜，不是知识' }
                  : {
                      tone: 'miss',
                      label: brandEntity
                        ? `答偏了：讲的是「${brandEntity}」`
                        : '没说出任何我们独有的事实',
                    }
              : mentioned
                ? { tone: idx <= answer.length * 0.34 ? 'hit' : 'part', label: idx <= answer.length * 0.34 ? '提及 · 前段' : '提及 · 中后段' }
                : { tone: 'miss', label: '未提及' };

          return {
            id: r.id,
            kind: r.kind,
            cat: r.cat || '',
            tier: r.tier || 'core',
            q: r.q,
            error: r.error || null,
            chars: answer.length,
            // Answer kept, trimmed: the raw text is the actual evidence, and the label above
            // is only a heuristic. Without it you cannot tell a real hit from a lucky match.
            answer: answer.length > 1600 ? answer.slice(0, 1600) + '…' : answer,
            mentioned,
            brand,
            brandFacts,
            brandGeneric,
            brandEntity,
            status,
            quote: mentioned ? sentenceAround(answer, idx) : '',
            alternatives: WATCHLIST.filter((w) => w.re.test(answer)).map((w) => w.name),
          };
        });
      }

      function buildReport(rows) {
        const counted = rows.filter((r) => !r.error);
        const rate = (arr) => (arr.length ? Math.round((arr.filter((r) => r.mentioned).length / arr.length) * 100) : 0);
        const discovery = counted.filter((r) => r.kind === 'discovery');
        const brand = counted.filter((r) => r.kind === 'brand');
        const brandKnown = brand.filter((r) => r.brand === 'known').length;

        // 跨轮可比的那一组：只算固定核心题。轮换题每轮不同，混进去百分比就跟着题目走。
        const discoveryCore = discovery.filter((r) => r.tier !== 'rotate');

        const freq = new Map();
        for (const r of rows) for (const c of r.alternatives) freq.set(c, (freq.get(c) || 0) + 1);

        // 按分类统计提及率。总数字是 10 类的平均，看不出哪个入口是 0；
        // 分类数字才是"该补哪块内容"的直接依据。
        const catMap = new Map();
        for (const r of discovery) {
          const key = r.cat || 'other';
          if (!catMap.has(key)) catMap.set(key, { id: key, label: catLabel(key), hit: 0, total: 0 });
          const bucket = catMap.get(key);
          bucket.total += 1;
          if (r.mentioned) bucket.hit += 1;
        }
        const byCategory = [...catMap.values()]
          .map((b) => ({ ...b, rate: b.total ? Math.round((b.hit / b.total) * 100) : 0 }))
          .sort((a, b) => a.rate - b.rate || a.label.localeCompare(b.label));

        const summary = {
          discoveryRate: rate(discovery),
          discoveryHit: discovery.filter((r) => r.mentioned).length,
          discoveryFront: discovery.filter((r) => r.mentioned && r.status.tone === 'hit').length,
          discoveryTotal: discovery.length,
          // 只含固定核心题的比率 —— 趋势线用它。
          coreRate: rate(discoveryCore),
          coreHit: discoveryCore.filter((r) => r.mentioned).length,
          coreTotal: discoveryCore.length,
          brandRate: brand.length ? Math.round((brandKnown / brand.length) * 100) : 0,
          brandHit: brandKnown,
          brandGuess: brand.filter((r) => r.brand === 'guessed').length,
          brandWrong: brand.filter((r) => r.brand === 'wrong').length,
          brandTotal: brand.length,
          failed: rows.length - counted.length,
          byCategory,
          alternatives: [...freq.entries()]
            .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
            .map(([name, count]) => ({ name, count })),
        };

        return { rows, summary, advice: deriveAdvice(rows, summary), adviceBy: 'rules' };
      }

      /** Rule-based, instant. The optional AI pass can replace this afterwards. */
      function deriveAdvice(rows, s) {
        const out = [];
        const missed = rows.filter((r) => !r.error && r.kind === 'discovery' && !r.mentioned);
        const top = s.alternatives.slice(0, 3);

        const wrongRows = rows.filter((r) => r.kind === 'brand' && r.brand === 'wrong');
        const confused = [...new Set(wrongRows.filter((r) => r.brandEntity).map((r) => r.brandEntity))];
        const bareWrong = wrongRows.filter((r) => !r.brandEntity).length;

        if (confused.length) {
          out.push(
            `模型把 "GFIC" 认成了**同名但不同的机构**：${confused.join(' / ')}。` +
              `这不是文案问题 —— 是 "GFIC" 这几个字母在我们的语料里，抢不过一个真实存在的教会缩写。` +
              `对策：凡是出现品牌名的地方一律写全 "GFIC Crew（GFIC歪果社）"，缩写绝不单独出现；` +
              `并紧挨着给可验证的实锤（城市清单、会员价、微信 DN8117），让"我们"成为这个词最强的那条关联。`,
          );
        }
        if (bareWrong) {
          out.push(
            `另有 ${bareWrong} 道品牌题：模型答得很流畅，但**说不出任何一个我们独有的事实**（中文名、DN8117、会员价、城市清单），` +
              `全是 "expat / community / Guangzhou" 这类换个机构也成立的话。这不算认识 —— 它只是在按字面编一个像样的答案。`,
          );
        }
        if (!s.brandWrong && s.brandGuess) {
          out.push(`模型对品牌名只能靠猜（原话里有"通常 / 可能是 / almost certainly"这类措辞），说明它的语料里没有这个实体。这是"有没有第三方来源"的问题，不是文案问题。`);
        } else if (!s.brandWrong && !s.brandGuess && s.brandTotal && s.brandHit === s.brandTotal) {
          out.push(`品牌题 ${s.brandHit}/${s.brandTotal} 答对。但注意：这是一道"送分题"——问题里就带着我们的名字，能答对只说明"看着名字能说出像样的话"，不等于它会在被问到别的时会想到我们。`);
        }

        // 分类里提及率为 0 的，是这份报告里最有行动指向的信息。
        const zeroCats = (Array.isArray(s.byCategory) ? s.byCategory : []).filter((b) => b.rate === 0);
        if (zeroCats.length) {
          out.push(
            `这些入口我们一次都没被提到：${zeroCats.map((b) => b.label).join('、')}。` +
              `对照站内看这一类有没有成篇的内容 —— 没有的，就是下一批该写的（写成"能被整段摘出来"的问答，第一句给结论）。`,
          );
        }

        if (s.discoveryTotal && s.discoveryHit === 0) {
          out.push(`普通问题 ${s.discoveryTotal} 题、我们 0 次出现。这是最该盯的数字：说明"在华外国人社交"这类答案池里，目前没有我们的位置。`);
        } else if (s.discoveryHit > 0) {
          out.push(`普通问题被提到 ${s.discoveryHit}/${s.discoveryTotal}，其中 ${s.discoveryFront} 次落在答案前段。前段才算真的被推荐，只在中后段出现容易被划过去。`);
        }

        if (top.length) {
          out.push(
            `模型更愿意点名：${top.map((t) => `${t.name}（${t.count} 次）`).join('、')}。这些地方有真实、可被引用的存在感，先看它们在同类问题下写的内容长什么样。`,
          );
        }

        if (missed.length) {
          out.push(
            `针对"${missed[0].q}"这类问法，官网需要一段能被直接摘出来的答案 —— 第一句就是结论，带具体城市、具体做法。目前 llms-full.txt 里没有以这种问句为入口的段落。`,
          );
        }

        out.push('站外是胜负手：Reddit / Quora 上真实、持续、有上下文的回答，比在自家站点再加十段文案有用。这里始终只是个基线数字。');
        return out.slice(0, 5);
      }

      async function pruneMonitor() {
        const rows = await list(MONITOR_COLLECTION);
        const runs = rows
          .filter((r) => r.docId !== MONITOR_PROBES_ID && r.docId !== MONITOR_ROTATION_ID)
          .sort((a, b) => String(a.docId).localeCompare(String(b.docId)));
        const excess = runs.slice(0, Math.max(0, runs.length - MONITOR_KEEP));
        for (const old of excess) await remove(MONITOR_COLLECTION, old.docId);
        return excess.length;
      }

      async function runMonitor() {
        const m = state.monitor;
        if (!m || m.running) return;

        const dropped = collectProbes();
        if (!m.probes.length) m.probes = DEFAULT_PROBES.map((p) => ({ ...p }));
        m.running = true;
        m.log = '';
        renderMonitor();

        const logEl = $('mon-log');
        const runBtn = $('mon-run');
        if (runBtn) {
          runBtn.disabled = true;
          runBtn.textContent = '监测中…';
        }
        const log = (line) => {
          m.log += (m.log ? '\n' : '') + line;
          if (logEl) {
            logEl.textContent = m.log;
            logEl.scrollTop = logEl.scrollHeight;
          }
        };
        if (dropped) log(`（已忽略 ${dropped} 条空问题）`);
        setProgress(4);

        // The model takes 40–170 s just to emit its first token, so the first log line after
        // "已发出" can be minutes away. Tick every 10 s so a long wait never looks like a hang.
        let ticker = null;
        let elapsed = 0;
        const stopTicker = () => {
          if (ticker) clearInterval(ticker);
          ticker = null;
        };

        try {
          const probes = m.probes.slice();
          const results = new Array(probes.length);
          let done = 0;

          // 并发不能开太高：题库扩容后一轮 37 题，之前提到 12 路，结果被腾讯云 WAF
          // 当成 CC 攻击拦了（返回整页 403 HTML）。降到 4 路，并给每次请求加抖动间隔，
          // 让流量看起来像正常使用而不是扫描。
          // 并发只是同时发多少请求，服务端照样排队，实测 4 路已有约 2.2 倍加速，再往上收益递减。
          const CONCURRENCY = Math.min(probes.length, 4);
          const JITTER_MS = 400; // 每个请求前的随机等待上限，避免同一毫秒齐发
          log(`${probes.length} 个探针（固定核心 + 本轮轮换），并发 ${CONCURRENCY}。每个问题都要等模型把话说完才开始返回，整轮通常 8–15 分钟，可以走开。`);
          log('');
          ticker = setInterval(() => {
            elapsed += 10;
            if (logEl) logEl.textContent = `${m.log}\n… 已等待 ${elapsed}s（已完成 ${done}/${probes.length}）`;
          }, 10000);

          const queue = probes.map((p, i) => ({ p, i }));
          const worker = async () => {
            for (;;) {
              const job = queue.shift();
              if (!job) return;
              const { p, i } = job;
              const label = `${p.kind === 'brand' ? '品牌题' : '普通题'}：${p.q}`;
              // 抖动：错开发车时间，别在同一毫秒齐发一堆请求。
              await sleep(Math.floor(Math.random() * JITTER_MS));
              log(`↑ 已发出 ${label}`);
              try {
                const answer = (
                  await llmWithRetry(
                    [
                      { role: 'system', content: PROBE_SYSTEM },
                      { role: 'user', content: p.q },
                    ],
                    {
                      onRetry: (attempt, wait) =>
                        log(`  ↻ 被安全策略拦下，${Math.round(wait / 1000)}s 后重试（第 ${attempt} 次）— ${label}`),
                    },
                  )
                ).trim();
                results[i] = { id: p.id, kind: p.kind, q: p.q, cat: p.cat || '', tier: p.tier || 'core', answer };
                log(`  ✓ [${++done}/${probes.length}] 返回 ${answer.length} 字 — ${label}`);
              } catch (err) {
                const msg = humanError(err);
                results[i] = { id: p.id, kind: p.kind, q: p.q, cat: p.cat || '', tier: p.tier || 'core', answer: '', error: msg };
                log(`  ✗ [${++done}/${probes.length}] 失败：${msg}`);
              }
              setProgress(4 + Math.round((done / probes.length) * 88));
            }
          };
          await Promise.all(Array.from({ length: CONCURRENCY }, worker));
          stopTicker();

          const rows = analyseAnswers(results.filter(Boolean));
          const answered = rows.filter((r) => !r.error);
          if (!answered.length) throw new Error('所有探针都调用失败了，无法生成报告');

          const report = buildReport(rows);
          report.at = new Date().toISOString();
          report.model = 'auto（WorkBuddy 托管模型）';

          report.round = currentRound();
          setProgress(94);
          await save(MONITOR_COLLECTION, 'run-' + report.at, report, 0);
          m.history.push({ docId: 'run-' + report.at, data: report });
          m.history.sort((a, b) => String(a.docId).localeCompare(String(b.docId)));
          if (m.history.length > MONITOR_KEEP) m.history = m.history.slice(-MONITOR_KEEP);

          // 轮次游标推进一格，下一轮换一组 rotate 题。存云端，换设备/刷新后接着走。
          const nextRound = (currentRound() + 1) % 997;
          m.round = nextRound;
          try {
            await save(MONITOR_COLLECTION, MONITOR_ROTATION_ID, { round: nextRound, updated: new Date().toISOString() }, 0);
          } catch (err) {
            log(`（轮次游标保存失败，下一轮可能重复本组轮换题：${err?.message || err}）`);
          }

          try {
            const removed = await pruneMonitor();
            if (removed) log(`已清理 ${removed} 份旧报告（只保留最近 ${MONITOR_KEEP} 份）。`);
          } catch (err) {
            log(`（旧报告清理失败，不影响本次结果：${err?.message || err}）`);
          }

          log('');
          log(
            `完成：核心题提及率 ${report.summary.coreRate}%（${report.summary.coreHit}/${report.summary.coreTotal}），` +
              `本轮全部普通题 ${report.summary.discoveryRate}%（${report.summary.discoveryHit}/${report.summary.discoveryTotal}），` +
              `品牌题 ${report.summary.brandHit}/${report.summary.brandTotal}。`,
          );
          show(els.msg, '报告已生成并保存到云端。', 'ok');
        } catch (err) {
          const msg = humanError(err);
          log('✗ ' + msg);
          show(els.msg, '监测失败：' + msg, 'err');
        } finally {
          stopTicker();
          m.running = false;
          setProgress(null);
          renderMonitor();
        }
      }

      /**
       * Optional second pass. Only runs when asked, because it costs the same 1–3 minutes as
       * a probe. Replaces the rule-based advice with something specific to the answers.
       */
      async function aiAdviceFor(runId) {
        const row = state.monitor.history.find((h) => h.docId === runId);
        if (!row) return;
        const r = row.data;
        const s = r.summary || {};
        show(els.msg, '正在让模型读报告并写建议…（1–3 分钟）', '');
        const digest = (r.rows || [])
          .map((x) => `${x.kind === 'brand' ? '[品牌]' : '[普通]'} ${x.q}\n  结果：${x.error ? '调用失败' : x.mentioned ? '提到了我们' : '没提到'}｜AI 提到的替代：${(x.alternatives || []).join('、') || '无'}${x.quote ? `\n  原话：${x.quote}` : ''}`)
          .join('\n');
        const catLines = (Array.isArray(s.byCategory) ? s.byCategory : [])
          .map((b) => `${b.label}：${b.hit}/${b.total}（${b.rate}%）`)
          .join('\n');
        const user = `这是 GFIC Crew (GFIC歪果社) 的 AI 回答监测报告 —— 我们让模型回答外国人常问的"在中国怎么认识人/有哪些外国人社群"等问题，然后看它有没有自然提到我们。

汇总：核心题提及率 ${s.coreRate}%（${s.coreHit}/${s.coreTotal}），本轮全部普通题 ${s.discoveryRate}%（${s.discoveryHit}/${s.discoveryTotal}），品牌题「真认识」${s.brandHit}/${s.brandTotal}（靠猜 ${s.brandGuess} 题、答偏 ${s.brandWrong} 题）。

按分类：
${catLines || '（本轮报告没有分类数据）'}

逐题：
${digest}

请给出 5 条具体、可执行的改进建议，简体中文，每条一到两句。要求：
- 优先针对**提及率为 0 的分类**：那是最明确的"这个入口我们完全不存在"。
- 针对上面实际出现的缺口，不要泛泛的 SEO 套话。
- 区分"站内能做的"和"必须在站外做的"，并在每条开头标出【站内】或【站外】。
- 涉及"让内容更容易被引用"时，要具体到该写什么形式的段落，并说明对应哪个分类的哪类问法。
- 不要建议任何违法违规内容（代办签证、介绍工作、VPN、旅游签打工）。`;
        try {
          const raw = await llmWithRetry([
            { role: 'system', content: '你是 GEO（生成式引擎优化）顾问，为一家在华外国人社群做内容与站外能见度诊断。只输出建议列表，不要前言。' },
            { role: 'user', content: user },
          ]);
          const lines = raw
            .split('\n')
            .map((l) => l.replace(/^\s*(?:\d+[.、)]|[-*])\s*/, '').trim())
            .filter((l) => l.length > 8);
          if (!lines.length) throw new Error('模型没有返回可用的建议');
          r.advice = lines.slice(0, 6);
          r.adviceBy = 'ai';
          await save(MONITOR_COLLECTION, runId, r, 0);
          show(els.msg, '建议已更新并保存。', 'ok');
        } catch (err) {
          show(els.msg, 'AI 建议生成失败：' + humanError(err), 'err');
        }
        renderMonitor();
      }

      function monitorMarkdown(r) {
        const s = r.summary || {};
        const L = [];
        L.push('# GFIC Crew · AI 回答监测报告');
        L.push('');
        L.push(`- 生成时间：${r.at ? new Date(r.at).toLocaleString('zh-CN') : '未知'}`);
        L.push(`- 使用模型：${r.model || '未知'}`);
        L.push(`- 探针数：${(r.rows || []).length}（固定核心 ${s.coreTotal ?? 0} + 轮换 ${(r.rows || []).length - (s.coreTotal ?? 0)}）`);
        if (r.round !== undefined) L.push(`- 轮次：第 ${(Number(r.round) || 0) + 1} 组`);
        L.push('');
        L.push('## 结论');
        L.push('');
        L.push(`- 核心题提及率（跨轮可比）：**${s.coreRate ?? 0}%**（${s.coreHit ?? 0}/${s.coreTotal ?? 0}）`);
        L.push(`- 本轮全部普通题提及率：**${s.discoveryRate ?? 0}%**（${s.discoveryHit ?? 0}/${s.discoveryTotal ?? 0}）`);
        L.push(`- 品牌问题「真认识」：**${s.brandRate ?? 0}%**（${s.brandHit ?? 0}/${s.brandTotal ?? 0}）`);
        if (s.brandGuess) L.push(`- 品牌问题靠猜：${s.brandGuess} 题（名字里有我们的字，但它说不出实情）`);
        if (s.brandWrong) {
          const confused = [...new Set((r.rows || []).filter((x) => x.brandEntity).map((x) => x.brandEntity))];
          L.push(
            `- 品牌问题答偏：${s.brandWrong} 题${confused.length ? `，被认成了 **${confused.join(' / ')}**` : '（说不出任何我们独有的事实）'} —— 这类"假命中"不能算认识`,
          );
        }
        if (s.failed) L.push(`- 调用失败：${s.failed} 题（未计入比例）`);
        L.push('');
        if (Array.isArray(s.byCategory) && s.byCategory.length) {
          L.push('## 按提问分类看提及率');
          L.push('');
          L.push('> 每类只跑少数几题；看的是"哪一类入口我们完全不存在"，不是单题百分比。');
          L.push('');
          L.push('| 分类 | 提及 | 提及率 |');
          L.push('| --- | --- | --- |');
          for (const b of s.byCategory) L.push(`| ${b.label} | ${b.hit}/${b.total} | ${b.rate}% |`);
          L.push('');
        }
        L.push('## 逐题结果');
        L.push('');
        L.push('| 问题 | 类型 | 结果 | AI 更愿意点名的 | 判定依据 | 原话 |');
        L.push('| --- | --- | --- | --- | --- | --- |');
        const cell = (v) => String(v === undefined || v === null ? '' : v).replace(/\|/g, '\\|').replace(/\n/g, ' ');
        for (const row of r.rows || []) {
          const basis =
            row.kind !== 'brand'
              ? ''
              : row.brandEntity
                ? '被认成 ' + row.brandEntity
                : (row.brandFacts || []).length
                  ? (row.brandFacts || []).join('、')
                  : '无独有事实' + ((row.brandGeneric || []).length ? `（只有 ${(row.brandGeneric || []).join('、')}）` : '');
          L.push(
            `| ${cell(row.q)} | ${row.kind === 'brand' ? '品牌' : '普通'} | ${cell((row.status || {}).label)} | ${cell((row.alternatives || []).join('、') || '—')} | ${cell(basis)} | ${cell(row.quote)} |`,
          );
        }
        L.push('');
        L.push('### 完整回答原文');
        L.push('');
        for (const row of r.rows || []) {
          L.push(`**${row.kind === 'brand' ? '[品牌]' : '[普通]'} ${row.q}** — ${(row.status || {}).label}`);
          L.push('');
          L.push(row.answer ? '> ' + row.answer.replace(/\n/g, '\n> ') : '（调用失败）');
          L.push('');
        }
        L.push('');
        if (Array.isArray(s.alternatives) && s.alternatives.length) {
          L.push('## AI 提到的替代来源');
          L.push('');
          for (const c of s.alternatives) L.push(`- ${c.name}（在 ${c.count} 题里出现）`);
          L.push('');
        }
        if (Array.isArray(r.advice) && r.advice.length) {
          L.push(`## 下一步建议（${r.adviceBy === 'ai' ? '模型生成' : '规则生成'}）`);
          L.push('');
          r.advice.forEach((a, i) => L.push(`${i + 1}. ${a}`));
          L.push('');
        }
        L.push('---');
        L.push('');
        L.push('说明：本报告由站内托管模型生成，用于观察趋势，不等于 ChatGPT / Perplexity / Gemini / 豆包 的真实回答。');
        L.push('判定方式是固定的，不依赖模型自评，所以每次运行可比：品牌题按顺序判 —— ① 认成别的机构（点名 or 断言宗教语境）→ 答偏；② 说出 ≥2 个我们独有的事实 → 真认识；③ 有"大概/可能是/almost certainly"这类措辞 → 在猜；④ ≥1 个独有事实 + ≥2 个通用词 → 真认识；其余 → 答偏。');
        L.push('注意：`expat`、`Guangzhou`、`community` 这类词任何机构都成立，**单靠它们不算认识**。');
        L.push('');
        return L.join('\n');
      }

      function downloadMonitorMarkdown(r) {
        const md = monitorMarkdown(r);
        const stamp = String(r.at || new Date().toISOString()).slice(0, 10);
        const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `gfic-ai-monitor-${stamp}.md`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      }

