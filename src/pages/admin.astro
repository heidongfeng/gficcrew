          </div>
        </header>
        <div class="content" id="pane"></div>
      </main>
    </div>

    <div class="actionbar hidden row" id="actionbar">
      <button class="btn btn--primary" type="button" id="btn-save">保存</button>
      <button class="btn btn--ghost" type="button" id="btn-back">返回</button>
      <span class="spacer"></span>
      <span class="save-hint" id="save-hint">⌘/Ctrl + S 保存</span>
      <button class="btn btn--danger" type="button" id="btn-del">删除</button>
    </div>

    <div class="modal" id="modal">
      <div class="modal-box">
        <h4 id="modal-title">确认</h4>
        <p id="modal-text"></p>
        <div style="display: flex; gap: 10px; justify-content: flex-end">
          <button class="btn btn--ghost" type="button" id="modal-cancel">取消</button>
          <button class="btn btn--primary" type="button" id="modal-ok">确定</button>
        </div>
      </div>
    </div>

    <div class="modal" id="pub-modal">
      <div class="modal-box modal-box--wide">
        <h4>设置一键发布</h4>
        <p>只需配置一次。令牌只用于触发发布，不需要给代码读写权限，也不会保存到云端。</p>
        <ol class="pub-steps">
          <li>打开 <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">GitHub 新建 fine-grained token</a>。</li>
          <li>Repository access 只选 <code>heidongfeng/gficcrew</code>。</li>
          <li>Permissions 里只把 <code>Actions</code> 设为 <code>Read and write</code>，其余保持 No access。</li>
          <li>生成后复制令牌，粘贴到下面。令牌会用当前后台口令加密后仅存在这台浏览器。</li>
        </ol>
        <label class="eyebrow" for="pub-token">GitHub token</label>
        <textarea class="pub-token" id="pub-token" autocomplete="off" spellcheck="false" placeholder="github_pat_…"></textarea>
        <div class="pub-modal-msg" id="pub-modal-msg"></div>
        <div class="pub-actions">
          <button class="btn btn--ghost" type="button" id="pub-cancel">取消</button>
          <button class="btn btn--primary" type="button" id="pub-save">验证并保存</button>
        </div>
      </div>
    </div>

    <script>
      import { createWorkBuddyCloud } from '@tencent-ai/workbuddy-cloud-sdk';
      import { codecToText, codecFromText, CODEC_HINT, slugify } from '../scripts/guide-codec.js';

      const ENDPOINT = 'https://gficcrew.app.workbuddy.host';
      const PUBLISHABLE_KEY = 'wbpk_1uORfVuxR6GP7CtKSD3Ciw_ZlNBhhoZQmyPg3rXxYL6aZvBv5miIAum';
      const PW_KEY = 'gfic_admin_pw';
      const THEME_KEY = 'gfic_admin_theme';
      const PUB_TOKEN_KEY = 'gfic_publish_token_v1';
      const PUB_LAST_KEY = 'gfic_publish_last_run';
      const GH_REPO = 'heidongfeng/gficcrew';
      const GH_WORKFLOW = 'publish.yml';
      const GH_API = 'https://api.github.com';

      const SEED = JSON.parse(document.getElementById('seed-payload').textContent || '{}');

      const cloud = createWorkBuddyCloud({ endpoint: ENDPOINT, publishableKey: PUBLISHABLE_KEY });
      const db = cloud.database;

      // slugify 由 ../scripts/guide-codec.js 提供，这里不再重复定义。
      // 之前两者同名并存：import 被本地 function 遮蔽，打包器把失效的 import 丢掉所以线上
      // 能跑，但这个脚本块本身不是合法 JS（Identifier 'slugify' has already been declared），
      // 任何直接解析它的工具都会失败。两处实现当时一致，但改一处会静默分叉。

      const COLLECTIONS = {
        site: {
          label: '站点内容',
          pageTitle: '站点内容',
          single: true,
          title: () => '品牌信息 / 导航 / 服务 / 规则',
          heading: '全站通用内容',
          groups: [
            {
              title: '首页（/）',
              fields: [
                { key: 'home.eyebrow', label: '顶部小标题', type: 'text' },
                { key: 'home.title', label: '主标题 H1', type: 'text' },
                {
                  key: 'home.lead',
                  label: '开头段落',
                  type: 'textarea',
                  wide: true,
                  hint: '写 {brand} 会自动替换成加粗的品牌名，不用手写。改品牌名请到下面「品牌」分组。',
                },
                {
                  key: 'home.highlights',
                  label: '主标题下面的亮点列表，一行一条',
                  type: 'list',
                  wide: true,
                  hint:
                    '就是主标题下面那几条要点。一行一条：改某一行＝修改内容，删某一行＝删除该条，在最后补一行＝新增一条。' +
                    '从上到下按顺序显示，建议 4–6 条。',
                },
              ],
            },
            {
              title: '首页各区块小标题',
              fields: [
                { key: 'home.servicesEyebrow', label: '「四大服务」小标题', type: 'text' },
                { key: 'home.servicesTitle', label: '「四大服务」标题', type: 'text' },
                { key: 'home.servicesLead', label: '「四大服务」引言', type: 'textarea', wide: true },

                { key: 'home.citiesEyebrow', label: '「城市与指南」小标题', type: 'text' },
                { key: 'home.citiesTitle', label: '「城市与指南」标题', type: 'text' },
                {
                  key: 'home.citiesLead',
                  label: '「城市与指南」引言',
                  type: 'textarea',
                  wide: true,
                  hint: '写 {cityCount} 会自动换成城市总数，城市增删后不用回来改数字。',
                },

                { key: 'home.eventsEyebrow', label: '「活动日历」小标题', type: 'text' },
                { key: 'home.eventsTitle', label: '「活动日历」标题', type: 'text' },

                { key: 'home.membershipEyebrow', label: '「会员」小标题', type: 'text' },
                { key: 'home.membershipTitle', label: '「会员」标题', type: 'text' },
                { key: 'home.membershipLead', label: '「会员」引言', type: 'textarea', wide: true },

                { key: 'home.whyJoinEyebrow', label: '「为什么加入」小标题', type: 'text' },
                { key: 'home.whyJoinTitle', label: '「为什么加入」标题', type: 'text' },
                {
                  key: 'home.whyJoinNote',
                  label: '「为什么加入」底部一行小字',
                  type: 'textarea',
                  wide: true,
                  hint: '可写 {name}、{socialLine}、{wechat}，构建时会自动替换成品牌名、平台名单和微信号。',
                },
              ],
            },
            {
              title: '品牌',
              fields: [
                { key: 'site.name', label: '品牌名', type: 'text' },
                { key: 'site.nameZh', label: '中文名', type: 'text' },
                { key: 'site.legalName', label: '法定名称', type: 'text' },
                { key: 'site.wechat', label: '微信号', type: 'text' },
                { key: 'site.tagline', label: '一句话简介', type: 'textarea', wide: true },
                { key: 'site.description', label: 'SEO 描述', type: 'textarea', wide: true },
                { key: 'site.intro', label: '社群介绍（正文）', type: 'textarea', wide: true },
                {
                  key: 'site.keywords',
                  label: '关键词，一行一个',
                  type: 'list',
                  wide: true,
                  hint:
                    '默认来自代码里写好的一组词。一行一个关键词：改某一行就是修改，删掉某一行就是删除，在最后补一行就是新增。' +
                    '这些词只用于页面 <meta name="keywords">，不影响页面可见内容。',
                },
              ],
            },
            {
              title: '条款与条目',
