      applyTheme(localStorage.getItem(THEME_KEY) || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
      $('btn-theme').addEventListener('click', () => {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      /* ---------- login ---------- */

      els.gateForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pw = els.gatePw.value;
        if (!pw) { show(els.gateMsg, '请输入管理口令', 'err'); return; }
        els.gateGo.disabled = true;
        els.gateGo.textContent = '验证中…';
        try {
          const ok = await rpc('cms_login', { p_password: pw });
          if (ok !== true) throw new Error('口令不正确');
          state.pw = pw;
          sessionStorage.setItem(PW_KEY, pw);
          enter();
        } catch (err) {
          show(els.gateMsg, err.message || '登录失败', 'err');
        } finally {
          els.gateGo.disabled = false;
          els.gateGo.textContent = '登录';
        }
      });

      /** Loads the single 站点内容 document used to feed shared option lists. */
      async function loadSiteData() {
        try {
          const docs = await list('site');
          state.siteData = (docs[0] && docs[0].data) || null;
        } catch (err) {
          state.siteData = null;
        }
      }

      function enter() {
        els.gate.classList.add('hidden');
        els.app.classList.remove('hidden');
        renderSide();
        loadSiteData();
        openCollection(state.collection);
      }

      function logout() {
        sessionStorage.removeItem(PW_KEY);
        state.pw = '';
        publishTokenCache = '';
        els.app.classList.add('hidden');
        els.gate.classList.remove('hidden');
        els.gatePw.value = '';
        els.actionbar.classList.add('hidden');
        show(els.gateMsg, '', '');
      }

      /* ---------- sidebar ---------- */

      function renderSide() {
        els.side.innerHTML = '';
        Object.keys(COLLECTIONS).forEach((key) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.dataset.collection = key;
          const text = document.createElement('span');
          text.textContent = COLLECTIONS[key].label;
          b.appendChild(text);
          const n = state.counts[key];
          if (typeof n === 'number') {
            const c = document.createElement('span');
            c.className = 'count';
            c.textContent = n;
            b.appendChild(c);
          }
          if (!state.tool && key === state.collection) b.className = 'is-active';
          b.addEventListener('click', () => openCollection(key));
          els.side.appendChild(b);
        });

        els.sideTools.innerHTML = '';
        Object.keys(TOOLS).forEach((key) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.dataset.tool = key;
          const text = document.createElement('span');
          text.textContent = TOOLS[key].label;
          b.appendChild(text);
          if (state.tool === key) b.className = 'is-active';
          b.addEventListener('click', () => openTool(key));
          els.sideTools.appendChild(b);
        });
      }

      /**
       * Opens one of the SEO/GEO tools. These are views, not collections — they have no
       * documents and no editor, so everything the collection machinery owns (search, the
       * "new" button, the save bar) is switched off while one is open.
       */
      function openTool(key) {
        if (state.tool === key) return;
        state.tool = key;
        state.editing = null;
        state.filter = '';
        els.search.value = '';
        els.search.disabled = true;
        els.actionbar.classList.add('hidden');
        $('btn-new').classList.add('hidden');
        $('btn-seed').classList.add('hidden');
        els.title.textContent = TOOLS[key].title;
        renderSide();
        if (key === 'monitor') openMonitor();
      }

      /* ---------- list ---------- */

      async function openCollection(key) {
        state.collection = key;
        state.tool = null;
        state.editing = null;
        state.filter = '';
        els.search.value = '';
        els.search.disabled = false;
        $('btn-seed').classList.remove('hidden');
        els.actionbar.classList.add('hidden');
        els.title.textContent = COLLECTIONS[key].pageTitle || COLLECTIONS[key].label;
        renderSide();
        show(els.msg, '载入中…', '');
        try {
          state.docs = await list(key);
          state.counts[key] = state.docs.length;
          if (key === 'site') state.siteData = (state.docs[0] && state.docs[0].data) || null;
          renderSide();
          renderList();
        } catch (err) {
          show(els.msg, '读取失败：' + (err.message || err), 'err');
        }
      }

      function renderList() {
        const cfg = COLLECTIONS[state.collection];
        if (cfg.single) {
          state.editing = state.docs[0] || { docId: 'main', data: SEED[state.collection] || {}, sortOrder: 0 };
          $('btn-new').classList.add('hidden');
          renderEditor();
          return;
        }

        const q = state.filter.trim().toLowerCase();
        const rows = state.docs
          .map((doc, i) => ({ doc, i }))
          .filter(({ doc }) => {
            if (!q) return true;
            const hay = (String(cfg.title(doc.data) || '') + ' ' + doc.docId).toLowerCase();
            return hay.includes(q);
          });

        els.pane.innerHTML = '';
        const head = document.createElement('div');
        head.className = 'list-head';
        head.innerHTML = '<span style="width:22px"></span><span style="flex:1">' + cfg.label + '</span><span>标识 ID</span>';
        els.pane.appendChild(head);

        const ul = document.createElement('ul');
        ul.className = 'list';
        if (!rows.length) {
          const empty = document.createElement('li');
          empty.className = 'empty';
          empty.textContent = q ? '没有匹配的条目' : '这个集合还没有内容，点下面「新增」开始。';
          ul.appendChild(empty);
        }
        rows.forEach(({ doc, i }) => {
          const li = document.createElement('li');
          const idx = document.createElement('span');
          idx.className = 'idx';
          idx.textContent = i + 1;
          const b = document.createElement('button');
          b.type = 'button';
          const label = document.createElement('span');
          label.textContent = cfg.title(doc.data) || doc.docId;
          b.appendChild(label);
          b.addEventListener('click', () => { state.editing = doc; renderEditor(); });
          const id = document.createElement('span');
          id.className = 'sub';
          id.textContent = doc.docId;

          // Delete straight from the list — every list-backed collection gets one.
          const del = document.createElement('button');
          del.className = 'row-del';
          del.type = 'button';
          del.textContent = '删除';
          del.addEventListener('click', async (ev) => {
            ev.stopPropagation();
            const name = cfg.title(doc.data) || doc.docId;
            if (!(await confirmDialog('「' + name + '」将从云端永久删除，无法撤销。', '删除确认'))) return;
            try {
              await remove(state.collection, doc.docId);
              await openCollection(state.collection);
              show(els.msg, '已删除「' + name + '」', 'ok');
            } catch (err) {
              show(els.msg, '删除失败：' + (err.message || err), 'err');
            }
          });

          li.appendChild(idx);
          li.appendChild(b);
          li.appendChild(id);
          li.appendChild(del);
          ul.appendChild(li);
        });
        els.pane.appendChild(ul);

        // The "new" action lives in the top bar next to import/export, not at the bottom.
        const nb = $('btn-new');
        nb.classList.remove('hidden');
        nb.textContent = '+ 新增' + cfg.label;
        show(els.msg, '', '');
      }

      els.search.addEventListener('input', () => {
        state.filter = els.search.value;
        if (!COLLECTIONS[state.collection].single) renderList();
      });

      /* ---------- editor ---------- */

      function switchMode(wrap, mode, field) {
        const el = wrap.querySelector('[data-key]');
        const cur = el.dataset.type;
        if ((mode === 'text' && cur === 'plaintext') || (mode === 'json' && cur === 'json')) return;
        try {
          if (mode === 'json') {
            el.value = JSON.stringify(codecFromText(el.value, field.codec), null, 2);
            el.dataset.type = 'json';
          } else {
            el.value = codecToText(el.value.trim() ? JSON.parse(el.value) : [], field.codec);
            el.dataset.type = 'plaintext';
          }
          wrap.querySelectorAll('.seg button').forEach((b) => {
            b.classList.toggle('is-on', b.dataset.mode === mode);
          });
          show(els.msg, '', '');
        } catch (err) {
          show(els.msg, mode === 'json' ? '转 JSON 失败：' + err.message : 'JSON 解析失败，已保留原文：' + err.message, 'err');
        }
      }

      /**
       * Downscales an image data URI so a phone photo doesn't bloat the database row.
       * Kept as PNG: QR edges have to stay sharp, and these files are small anyway.
       */
      function shrinkImage(dataUri, max) {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            const scale = Math.min(1, max / Math.max(img.width, img.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.max(1, Math.round(img.width * scale));
            canvas.height = Math.max(1, Math.round(img.height * scale));
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            resolve(canvas.toDataURL('image/png'));
          };
          img.onerror = () => reject(new Error('图片无法解码，换一张试试'));
          img.src = dataUri;
        });
      }

      function renderEditor() {
        const cfg = COLLECTIONS[state.collection];
        const doc = state.editing;
        const data = doc.data || {};
        // Single documents saved before a field was introduced would otherwise render blank.
        const fallback = cfg.single ? SEED[state.collection] || {} : null;

        els.pane.innerHTML = '';
        els.title.textContent = cfg.single
          ? (cfg.pageTitle || cfg.label)
          : doc.isNew
            ? '新增' + cfg.label
            : (cfg.title(doc.data) || doc.docId);

        const head = document.createElement('div');
        head.className = 'editor-head';
        const h3 = document.createElement('h3');
        h3.textContent = cfg.single
          ? (cfg.heading || '全站通用内容')
          : (cfg.title(doc.data) || '新' + cfg.label);
        head.appendChild(h3);
        if (cfg.single) {
          const chip = document.createElement('span');
          chip.className = 'chip';
          chip.textContent = '单一文档';
          head.appendChild(chip);
        }
        els.pane.appendChild(head);

        if (!cfg.single) {
          // Identification card. Most collections derive their id from a field (slug / id),
          // so there is no separate box to fill in — only FAQ, which has no such field,
          // shows a live preview of the id that will be generated from the question.
          const meta = document.createElement('div');
          meta.className = 'card';
          const mt = document.createElement('div');
          mt.className = 'card-title';
          const mspan = document.createElement('span');
          mspan.className = 'eyebrow';
          mspan.textContent = '标识与排序';
          mt.appendChild(mspan);
          meta.appendChild(mt);

          const grid = document.createElement('div');
          grid.className = 'grid2';

          const sortWrap = document.createElement('div');
          sortWrap.className = 'field';
          const sortLabel = document.createElement('label');
          sortLabel.textContent = '排序（数字小的排前面）';
          sortWrap.appendChild(sortLabel);
          const sortInput = document.createElement('input');
          sortInput.id = 'f-sort';
          sortInput.type = 'number';
          sortInput.value = String(doc.sortOrder || 0);
          sortWrap.appendChild(sortInput);
          grid.appendChild(sortWrap);

          if (cfg.idField) {
            const noteWrap = document.createElement('div');
            noteWrap.className = 'field';
            const note = document.createElement('p');
            note.className = 'idnote';
            note.textContent = '标识 ID 取自「' + fieldLabel(cfg, cfg.idField) + '」字段：' + (cfg.idNote || '');
            noteWrap.appendChild(note);
            grid.appendChild(noteWrap);
          } else {
            const prevWrap = document.createElement('div');
            prevWrap.className = 'field';
            const pl = document.createElement('label');
            pl.textContent = '标识 ID（自动生成，不用填）';
            prevWrap.appendChild(pl);
            const prev = document.createElement('div');
            prev.className = 'idpreview';
            prev.id = 'id-preview';
            prev.textContent = cfg.idPreview ? cfg.idPreview(data) : doc.docId;
            prevWrap.appendChild(prev);
            grid.appendChild(prevWrap);
          }

          meta.appendChild(grid);
          els.pane.appendChild(meta);
        }

        const groups = cfg.groups || [{ title: '内容', fields: cfg.fields }];
        groups.forEach((group) => {
          const card = document.createElement('div');
          card.className = 'card';
          const ct = document.createElement('div');
          ct.className = 'card-title';
          const t = document.createElement('span');
          t.className = 'eyebrow';
          t.textContent = group.title;
          ct.appendChild(t);
          card.appendChild(ct);

          const grid = document.createElement('div');
          grid.className = 'grid2';
          group.fields.forEach((field) => {
            // 城市指南专用：选一次城市，就把必须彼此一致的三项（Slug / 城市名 /
            // 对应城市 Slug）一次填好。下拉里列出全部城市，已经写过指南的城市会标出来
            // —— 因为记录 ID 就是 Slug，选中已存在的城市，保存时会覆盖那一篇。
            if (field.key === 'slug' && state.collection === 'guides') {
              // 城市表来自随页面下发的 seed（客户端脚本拿不到 frontmatter 里的 import）。
              const allCities = Array.isArray(SEED.cities) ? SEED.cities : [];
              // guided：有指南的城市，用来打「✓ 已有指南」标记 —— 包含正在编辑的这一篇。
              // conflict：会被覆盖的别的记录（= 别的指南占用的 ID），用来决定要不要报红。
              // 分开是因为「编辑广州那篇时下拉里选中广州」不算冲突（就是它自己）。
              const guided = new Set();
              const conflict = new Set();
              state.docs.forEach((d) => {
                const isSelf = String(d.docId || '') === String(doc.docId || '');
                if (d.docId) {
                  guided.add(String(d.docId));
                  if (!isSelf) conflict.add(String(d.docId));
                }
                const cs = getPath(d.data || {}, 'citySlug');
                if (cs) {
                  guided.add(String(cs));
                  if (!isSelf) conflict.add(String(cs));
                }
              });

              const pick = document.createElement('div');
              pick.className = 'field field--wide';
              const plabel = document.createElement('label');
              plabel.textContent = '选择城市（自动填好下面三项）';
              pick.appendChild(plabel);

              const sel = document.createElement('select');
              const ph = document.createElement('option');
              ph.value = '';
              ph.textContent = '— 点这里选择城市 —';
              sel.appendChild(ph);
              allCities.forEach((c) => {
                const o = document.createElement('option');
                o.value = c.slug;
                o.textContent = guided.has(String(c.slug)) ? c.name + '　✓ 已有指南' : c.name;
                sel.appendChild(o);
              });
              const currentCity = String(getPath(data, 'citySlug') || '');
              if (currentCity && allCities.some((c) => String(c.slug) === currentCity)) sel.value = currentCity;
              pick.appendChild(sel);

              const phint = document.createElement('span');
              phint.className = 'hint';
              phint.textContent =
                '选中后会自动填好「Slug（URL 用）」「城市名」「对应城市 Slug」。' +
                '标了「✓ 已有指南」的城市，直接新建会覆盖原来那一篇。';
              pick.appendChild(phint);

              sel.addEventListener('change', () => {
                const c = allCities.find((x) => String(x.slug) === sel.value);
                if (!c) return;
                const setVal = (key, val) => {
                  const el = grid.querySelector('[data-key="' + key + '"]');
                  if (el) el.value = val;
                };
                setVal('slug', c.slug);
                setVal('city', c.name);
                setVal('citySlug', c.slug);
                if (conflict.has(String(c.slug))) {
                  show(els.msg, '「' + c.name + '」已经有一篇指南了。直接保存会覆盖那一篇，请先改 Slug 或确认要覆盖。', 'err');
                } else {
                  show(els.msg, '已按「' + c.name + '」填好三个字段，可以继续修改。', 'ok');
                }
              });

              grid.appendChild(pick);
            }

            const wrap = document.createElement('div');
            wrap.className = 'field' + (field.wide ? ' field--wide' : '');
            let raw = getPath(data, field.key);
            if (raw === undefined && fallback) raw = getPath(fallback, field.key);
            let control;

            if (field.type === 'boolean') {
              control = document.createElement('div');
              control.className = 'switch';
              const cb = document.createElement('input');
              cb.type = 'checkbox';
              cb.checked = !!raw;
              cb.dataset.key = field.key;
              cb.dataset.type = 'boolean';
              const lb = document.createElement('label');
              lb.textContent = '启用';
              control.appendChild(cb);
              control.appendChild(lb);
              wrap.appendChild(control);
            } else if (field.type === 'image') {
              // Images travel as data URIs so they ride along with the content export and
              // reach the static build — no separate asset host needed.
              const current = typeof raw === 'string' && raw.startsWith('data:image') ? raw : '';
              const ilabel = document.createElement('label');
              ilabel.textContent = field.label;
              wrap.appendChild(ilabel);

              const box = document.createElement('div');
              box.className = 'imgbox';
              const img = document.createElement('img');
              img.className = 'imgprev';
              img.alt = field.label;
              img.src = current || (field.previewSrc || '');
              img.style.display = img.getAttribute('src') ? '' : 'none';
              box.appendChild(img);

              const holder = document.createElement('input');
              holder.type = 'hidden';
              holder.value = current;
              holder.dataset.key = field.key;
              holder.dataset.type = 'image';
              box.appendChild(holder);

              const file = document.createElement('input');
              file.type = 'file';
              file.accept = 'image/png,image/jpeg,image/webp,image/gif';
              file.className = 'fileinput';
              file.addEventListener('change', () => {
                const f = file.files && file.files[0];
                file.value = '';
                if (!f) return;
                if (!/^image\//.test(f.type)) {
                  show(els.msg, '请选择图片文件（PNG / JPG / WebP）', 'err');
                  return;
                }
                const reader = new FileReader();
                reader.onerror = () => show(els.msg, '图片读取失败', 'err');
                reader.onload = () => {
                  shrinkImage(String(reader.result), field.maxSize || 1200)
                    .then((uri) => {
                      if (uri.length > 1200000) {
                        show(els.msg, '这张图处理后仍有 ' + Math.round(uri.length / 1024) + ' KB，太大了，换一张小一点的', 'err');
                        return;
                      }
                      holder.value = uri;
                      img.src = uri;
                      img.style.display = '';
                      show(els.msg, '图片已读取（' + Math.round(uri.length / 1024) + ' KB），记得点「保存」', 'ok');
                    })
                    .catch((err) => show(els.msg, '图片处理失败：' + (err.message || err), 'err'));
                };
                reader.readAsDataURL(f);
              });
              box.appendChild(file);

              const clear = document.createElement('button');
              clear.type = 'button';
              clear.className = 'btn btn--ghost btn--sm';
              clear.textContent = '移除图片';
              clear.addEventListener('click', () => {
                holder.value = '';
                img.removeAttribute('src');
                img.style.display = 'none';
                show(els.msg, '已移除，记得点「保存」', 'ok');
              });
              box.appendChild(clear);

              const ihint = document.createElement('span');
              ihint.className = 'hint';
              ihint.textContent =
                (current ? '当前：后台上传的图片。' : '当前：代码内的默认图片。') +
                '上传后需「导出内容 JSON」并重新构建才会出现在官网上。';
              box.appendChild(ihint);
              wrap.appendChild(box);
              grid.appendChild(wrap);
              return;
            } else {
              const label = document.createElement('label');
              label.textContent = field.label;
              wrap.appendChild(label);

              // Rich fields (guide sections / faq) default to readable plain text and can
              // be flipped to raw JSON and back without losing anything.
              if (field.type === 'plaintext') {
                const seg = document.createElement('div');
                seg.className = 'seg';
                [['text', '纯文本'], ['json', 'JSON']].forEach(([mode, text], i) => {
                  const b = document.createElement('button');
                  b.type = 'button';
                  b.textContent = text;
                  b.dataset.mode = mode;
                  if (i === 0) b.className = 'is-on';
                  b.addEventListener('click', () => switchMode(wrap, mode, field));
                  seg.appendChild(b);
                });
                wrap.appendChild(seg);
              }

              if (
                field.type === 'text' ||
                field.type === 'number' ||
                field.type === 'date' ||
                field.type === 'datetime-local'
              ) {
                control = document.createElement('input');
                control.type = field.type;
                control.value = raw == null ? '' : String(raw);
              } else {
                control = document.createElement('textarea');
                let v = raw;
                if (field.type === 'list') v = Array.isArray(raw) ? raw.join('\n') : '';
                else if (field.type === 'plaintext') v = codecToText(raw, field.codec);
                else if (field.type === 'json') v = raw == null ? '' : JSON.stringify(raw, null, 2);
                control.value = v == null ? '' : String(v);
                if (field.type === 'plaintext') control.style.minHeight = '260px';
              }
              control.dataset.key = field.key;
              control.dataset.type = field.type;
              if (field.codec) control.dataset.codec = field.codec;
              wrap.appendChild(control);
              maybeAddAiButton(wrap, control, field);
              const hintText = field.hint || (field.codec ? CODEC_HINT[field.codec] : '');
              if (hintText) {
                const hint = document.createElement('span');
                hint.className = 'hint';
                hint.textContent = hintText;
                wrap.appendChild(hint);
              }

              // Free-text field backed by a known value list: native autocomplete plus
              // one-click chips, so typos don't create new values. Sources are the managed
              // list in 站点内容 (optionsFrom) and every value already in use (suggestFrom).
              if (field.optionsFrom || field.suggestFrom) {
                const values = new Set();
                if (field.optionsFrom && state.siteData) {
                  const managed = getPath(state.siteData, field.optionsFrom);
                  if (Array.isArray(managed)) {
                    managed.forEach((v) => {
                      if (v && typeof v === 'string') values.add(v);
                    });
                  }
                }
                if (field.suggestFrom) {
                  state.docs
                    .map((d) => getPath(d.data || {}, field.suggestFrom))
                    .filter((v) => v && typeof v === 'string')
                    .forEach((v) => values.add(v));
                }
                const sorted = [...values].sort((a, b) => a.localeCompare(b));
                if (sorted.length) {
                  const listId = 'dl-' + field.key.replace(/[^a-z0-9]/gi, '-');
                  const dl = document.createElement('datalist');
                  dl.id = listId;
                  sorted.forEach((v) => {
                    const o = document.createElement('option');
                    o.value = v;
                    dl.appendChild(o);
                  });
                  wrap.appendChild(dl);
                  control.setAttribute('list', listId);

                  const chips = document.createElement('div');
                  chips.className = 'chips';
                  sorted.forEach((v) => {
                    const c = document.createElement('button');
                    c.type = 'button';
                    c.className = 'chip-btn';
                    c.textContent = v;
                    c.addEventListener('click', () => { control.value = v; });
                    chips.appendChild(c);
                  });
                  wrap.appendChild(chips);
                }
              }
            }
            grid.appendChild(wrap);
          });
          card.appendChild(grid);
          els.pane.appendChild(card);
        });

        // For collections with no id field of their own (FAQ), show the id that will be
        // generated and keep it in sync while the question is typed.
        const preview = $('id-preview');
        if (preview && cfg.idPreview) {
          els.pane.querySelectorAll('[data-key]').forEach((el) => {
            el.addEventListener('input', () => {
              preview.textContent = cfg.idPreview(collectFormData().data);
            });
          });
        }

        els.actionbar.classList.remove('hidden');
        $('btn-del').classList.toggle('hidden', !!cfg.single || !!doc.isNew);
        show(els.msg, '', '');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      $('btn-back').addEventListener('click', () => {
        if (!COLLECTIONS[state.collection].single) renderList();
      });

      $('btn-new').addEventListener('click', () => {
        const cfg = COLLECTIONS[state.collection];
        if (cfg.single) return;
        state.editing = { docId: '', data: cfg.blank(), sortOrder: state.docs.length, isNew: true };
        renderEditor();
      });

      /* ---------- save / delete ---------- */

      /** Reads every rendered field back into a data object. */
      function collectFormData() {
        const doc = state.editing;
        const data = JSON.parse(JSON.stringify(doc.data || {}));
        let jsonError = null;
        els.pane.querySelectorAll('[data-key]').forEach((el) => {
          const { key, type } = el.dataset;
          let value;
          if (type === 'boolean') value = el.checked;
          else if (type === 'number') value = el.value === '' ? 0 : Number(el.value);
          else if (type === 'list') value = el.value.split('\n').map((s) => s.trim()).filter(Boolean);
          else if (type === 'plaintext') value = codecFromText(el.value, el.dataset.codec);
          else if (type === 'json') {
            const t = el.value.trim();
            if (!t) value = [];
            else {
              try { value = JSON.parse(t); } catch (e) { jsonError = key + ' 不是合法 JSON，已停止保存'; }
            }
          } else value = el.value;
          setPath(data, key, value);
        });
        return { data, jsonError };
      }

      async function doSave() {
        const cfg = COLLECTIONS[state.collection];
        const doc = state.editing;
        if (state.busy || !doc) return;
        state.busy = true;
        const btn = $('btn-save');
        btn.disabled = true;
        btn.textContent = '保存中…';

        const { data, jsonError } = collectFormData();

        if (jsonError) {
          show(els.msg, jsonError, 'err');
          btn.disabled = false;
          btn.textContent = '保存';
          state.busy = false;
          return;
        }

        let docId = doc.docId;
        let renamedFrom = '';
        if (!cfg.single) {
          docId = cfg.docId(data);
          if (!docId) {
            show(els.msg, '标识 ID 生成不出来，请检查「' + (cfg.idField ? fieldLabel(cfg, cfg.idField) : '问题') + '」是否已填写', 'err');
            btn.disabled = false;
            btn.textContent = '保存';
            state.busy = false;
            return;
          }
          // Renaming the identifying field would otherwise orphan the old record.
          if (!doc.isNew && doc.docId && doc.docId !== docId) renamedFrom = doc.docId;
          doc.docId = docId;
        }
        const sortInput = $('f-sort');
        const sortOrder = sortInput ? Number(sortInput.value || 0) : 0;

        try {
          await save(state.collection, docId, data, sortOrder);
          if (renamedFrom) await remove(state.collection, renamedFrom);
          doc.data = data;
          doc.isNew = false;
          // 站点内容 holds shared option lists (event categories), so keep the local copy fresh.
          if (state.collection === 'site') await loadSiteData();
          $('btn-del').classList.remove('hidden');
          show(
            els.msg,
            '已保存到云端' + (renamedFrom ? '（原标识 ' + renamedFrom + ' 已替换）' : '') + '。点顶部「发布上线」即可发布。',
            'ok',
          );
        } catch (err) {
          show(els.msg, '保存失败：' + (err.message || err), 'err');
        } finally {
          btn.disabled = false;
          btn.textContent = '保存';
          state.busy = false;
        }
      }

      $('btn-save').addEventListener('click', doSave);

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          if (!els.actionbar.classList.contains('hidden')) doSave();
        }
      });

      $('btn-del').addEventListener('click', async () => {
        const cfg = COLLECTIONS[state.collection];
        const doc = state.editing;
        const ok = await confirmDialog('「' + (cfg.title(doc.data) || doc.docId) + '」将从云端永久删除，无法撤销。', '删除确认');
        if (!ok) return;
        try {
          await remove(state.collection, doc.docId);
          await openCollection(state.collection);
          show(els.msg, '已删除', 'ok');
        } catch (err) {
          show(els.msg, '删除失败：' + (err.message || err), 'err');
        }
      });

      /* ---------- topbar actions ---------- */

      $('btn-out').addEventListener('click', logout);

      $('btn-pw').addEventListener('click', async () => {
        const next = prompt('新的管理口令（至少 8 位）：');
        if (!next) return;
        let savedToken = '';
        try { savedToken = await getPublishToken(); } catch { savedToken = ''; }
        try {
          await rpc('cms_set_password', { p_password: state.pw, p_new_password: next });
          state.pw = next;
          sessionStorage.setItem(PW_KEY, next);
          publishTokenCache = '';
          // Keep the one-click publish token usable after a password rotation.
          if (savedToken) await savePublishToken(savedToken);
          show(els.msg, '口令已更新，下次登录请用新口令', 'ok');
        } catch (err) {
          show(els.msg, '修改失败：' + (err.message || err), 'err');
        }
      });

      $('btn-seed').addEventListener('click', async () => {
        const ok = await confirmDialog('把代码里的现有内容写入云端数据库？同名条目会被覆盖，云端已有的自定义内容不会被删除。', '导入初始数据');
        if (!ok) return;
        const total = Object.entries(SEED).reduce(
          (n, [k, v]) => n + (COLLECTIONS[k] && COLLECTIONS[k].single ? 1 : (Array.isArray(v) ? v.length : 0)),
          0,
        );
        let done = 0;
        show(els.msg, `导入中… 0/${total}`, '');
        setProgress(0);
        try {
          for (const [collection, value] of Object.entries(SEED)) {
            if (COLLECTIONS[collection] && COLLECTIONS[collection].single) {
              await save(collection, 'main', value, 0);
              done += 1;
              show(els.msg, `导入中… ${done}/${total}`, '');
              setProgress(Math.round((done / total) * 100));
              continue;
            }
            const cfg = COLLECTIONS[collection];
            for (let i = 0; i < value.length; i += 1) {
              await save(collection, cfg.docId(value[i]), value[i], i);
              done += 1;
              show(els.msg, `导入中… ${done}/${total}`, '');
              setProgress(Math.round((done / total) * 100));
            }
          }
        } catch (err) {
          setProgress(null);
          show(els.msg, '导入失败：' + (err.message || err), 'err');
          return;
        }
        setProgress(null);
        // openCollection clears the status line, so write the confirmation afterwards.
        await openCollection(state.collection);
        show(els.msg, `初始数据已导入云端（共 ${total} 条）。`, 'ok');
      });

      $('btn-export').addEventListener('click', async () => {
        show(els.msg, '导出中…', '');
        try {
          const out = {};
          for (const key of Object.keys(COLLECTIONS)) out[key] = await list(key);
          const blob = new Blob([JSON.stringify(out, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'gfic-content-' + new Date().toISOString().slice(0, 10) + '.json';
          a.click();
          URL.revokeObjectURL(url);
          show(els.msg, '已下载。把文件放到项目根目录并运行 npm run content:import 即可写回代码。', 'ok');
        } catch (err) {
          show(els.msg, '导出失败：' + (err.message || err), 'err');
        }
      });

      /* ---------- boot ---------- */

      if (location.origin !== ENDPOINT) {
        els.warn.classList.remove('hidden');
        els.warn.textContent =
          '当前域名是 ' + location.origin + '，与云服务绑定的 ' + ENDPOINT +
          ' 不一致，云端读写会被拒绝。请从 ' + ENDPOINT + '/admin/ 打开本页。';
      }

      if (state.pw) {
        rpc('cms_login', { p_password: state.pw })
          .then((ok) => { if (ok === true) enter(); else logout(); })
          .catch(() => logout());
      }
    </script>
    <script
      type="application/json"
      id="seed-payload"
      is:inline
      set:html={JSON.stringify(SEED).replace(/</g, '\\u003c')}
    ></script>
  </body>
</html>
