---
import { SITE } from '../data/site.js';

// The Guangzhou guide moved to /guides/guangzhou/ when city guides became a section.
const target = new URL('/guides/guangzhou/', SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Guangzhou Expat Living Guide — GFIC Crew</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p style="font-family:system-ui,sans-serif;padding:24px">
      This guide has moved to <a href={target}>{target}</a>.
    </p>
  </body>
</html>
