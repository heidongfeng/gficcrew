  "auth": {
    "mechanism": "cms_admin.password_hash = crypt(p_password, password_hash) —— bcrypt，cost 10，盐内嵌在哈希里",
    "kdf": "bcrypt",
    "kdfRounds": 10,
    "perPasswordSalt": true,
    "saltStorage": "内嵌在 password_hash 中（$2a$10$ + 22 位盐 + 31 位哈希）。cms_admin.salt 列保留但为 NULL，只用于识别旧哈希；该列的 NOT NULL 约束已解除",
    "rateLimited": true,
    "lockout": true,
    "lockoutPolicy": "连续 5 次失败 → 锁 15 分钟；锁定期内即使口令正确也返回 false；成功即清零。计数在 cms_admin.failed_attempts，解锁时间在 locked_until",
    "legacyHashAccepted": true,
    "legacyUpgrade": "旧 sha256 哈希验通过时，cms_login 就地把哈希改写成 bcrypt 并清空 salt —— 迁移不会把管理员锁在外面",
    "minNewPasswordLength": 8,
    "enforcedServerSide": true,
    "pgcryptoAvailable": [
      "crypt",
      "gen_salt",
      "digest",
      "hmac",
      "encrypt"
    ],
    "verifyCentralised": "cms_list / cms_save / cms_delete / cms_set_password 全部调用 cms_login 做校验，所以口令逻辑只有一处，换 KDF 不需要逐个函数改",
    "why": "2026-10-04 已修。原为单轮 SHA-256 加单列固定盐，GPU 下每秒可试数十亿次；而 cms_login 对 anon 可执行且没有限速或锁定，两者叠加使口令成为可暴力破解的单点。现改用 bcrypt 并加失败计数与锁定。"
